<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EasySave.ViewModels"
        mc:Ignorable="d" d:DesignWidth="2400" d:DesignHeight="1400"
        x:Class="EasySave.View.GUI.MainWindow"
        Icon="/Assets/app-icon.png"
        Title="EasySave - Backup Manager"
        Width="1200"
        Height="700"
        MinWidth="900"
        MinHeight="600"
        Background="{DynamicResource AppBackground}">

    <!-- Remove TextBox inner border/chrome for search -->
    <Window.Styles>
        <Style Selector="TextBox#SearchBox">
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="TextBox#SearchBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox#SearchBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox#SearchBox /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Styles>

    <Grid>
        <!-- Main Layout: Sidebar + Content -->
        <Grid ColumnDefinitions="100,*">

            <!-- Sidebar -->
            <Border Grid.Column="0" Classes="Sidebar">
                <Grid RowDefinitions="Auto,*,Auto,Auto,Auto">

                    <!-- Home Button -->
                    <Grid Grid.Row="0" Margin="12,16,12,8">
                        <Button Classes="SidebarButton"
                                Command="{Binding GoHomeCommand}"
                                ToolTip.Tip="Home">
                            <Panel>
                                <Viewbox Width="32" Height="32">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{DynamicResource SidebarIcon}" Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                                    </Canvas>
                                </Viewbox>
                                <!-- Active/Error badge -->
                                <Ellipse Width="8" Height="8" Fill="#F44336"
                                         HorizontalAlignment="Right" VerticalAlignment="Top"
                                         Margin="0,-2,-2,0"
                                         IsVisible="{Binding HasActiveOrErrorJobs}"/>
                            </Panel>
                        </Button>
                        <!-- Active indicator -->
                        <Border Height="3" Width="28" CornerRadius="1.5"
                                Background="{DynamicResource AccentBlue}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                IsVisible="{Binding IsHomeActive}"/>
                    </Grid>

                    <!-- Spacer -->
                    <Border Grid.Row="1"/>

                    <!-- View Logs Button -->
                    <Button Grid.Row="2"
                            Classes="SidebarButton"
                            Command="{Binding ViewLogsCommand}"
                            ToolTip.Tip="View Logs"
                            Margin="12,8">
                        <Viewbox Width="32" Height="32">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{DynamicResource SidebarIcon}" Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- Settings Button -->
                    <Grid Grid.Row="3" Margin="12,8">
                        <Button Classes="SidebarButton"
                                Command="{Binding OpenSettingsCommand}"
                                ToolTip.Tip="Settings">
                            <Viewbox Width="32" Height="32">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{DynamicResource SidebarIcon}" Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <!-- Active indicator -->
                        <Border Height="3" Width="28" CornerRadius="1.5"
                                Background="{DynamicResource AccentBlue}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                IsVisible="{Binding IsSettingsOpen}"/>
                    </Grid>

                    <!-- Help Button -->
                    <Grid Grid.Row="4" Margin="12,8,12,16">
                        <Button Classes="SidebarButton"
                                Command="{Binding OpenHelpCommand}"
                                ToolTip.Tip="Help">
                            <Viewbox Width="32" Height="32">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{DynamicResource SidebarIcon}" Data="M11 18h2v-2h-2v2zm1-16C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14c-2.21 0-4 1.79-4 4h2c0-1.1.9-2 2-2s2 .9 2 2c0 2-3 1.75-3 5h2c0-2.25 3-2.5 3-5 0-2.21-1.79-4-4-4z"/>
                                </Canvas>
                            </Viewbox>
                        </Button>
                        <!-- Active indicator -->
                        <Border Height="3" Width="28" CornerRadius="1.5"
                                Background="{DynamicResource AccentBlue}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                IsVisible="{Binding IsHelpOpen}"/>
                    </Grid>

                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1">
                <ScrollViewer Padding="32" IsVisible="{Binding IsHomeActive}">
                    <StackPanel Spacing="24" MaxWidth="1000">

                        <!-- Header with Action Buttons -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="8">
                                <TextBlock Text="Backup Tasks"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Manage your backup tasks"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>

                            <!-- Logo -->
                            <Image Grid.Column="1"
                                   Source="/Assets/app-icon-in.png"
                                   Width="160"
                                   Height="160"
                                   Stretch="Uniform"
                                   VerticalAlignment="Top"
                                   Margin="0,0,8,0"/>
                        </Grid>

                        <!-- Dashboard Stats -->
                        <Grid ColumnDefinitions="*,12,*,12,*,12,*" IsVisible="{Binding !HasNoJobs}">
                            <Border Grid.Column="0" Classes="Card" Padding="16,14">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="40" Height="40" CornerRadius="10" Background="#222196F3">
                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="#2196F3" Data="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H8V4h12v12z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding TotalJobsCount}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="Total" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Classes="Card" Padding="16,14">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="40" Height="40" CornerRadius="10" Background="#224CAF50">
                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="#4CAF50" Data="M8 5v14l11-7z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ActiveJobsCount}" FontSize="22" FontWeight="Bold" Foreground="#4CAF50"/>
                                        <TextBlock Text="Active" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Classes="Card" Padding="16,14">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="40" Height="40" CornerRadius="10" Background="#222196F3">
                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="#2196F3" Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CompletedJobsCount}" FontSize="22" FontWeight="Bold" Foreground="#2196F3"/>
                                        <TextBlock Text="Done" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="6" Classes="Card" Padding="16,14">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <Border Width="40" Height="40" CornerRadius="10" Background="#22F44336">
                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="#F44336" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Spacing="2" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding ErrorJobsCount}" FontSize="22" FontWeight="Bold" Foreground="#F44336"/>
                                        <TextBlock Text="Errors" FontSize="11" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Select All Button -->
                        <Button Command="{Binding SelectAllCommand}"
                                Background="Transparent"
                                BorderBrush="{DynamicResource ClickableCardBorder}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="14,8"
                                HorizontalAlignment="Left"
                                Cursor="Hand"
                                IsVisible="{Binding !HasNoJobs}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Viewbox Width="16" Height="16">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{DynamicResource TextSecondary}" Data="M18 7l-1.41-1.41-6.34 6.34 1.41 1.41L18 7zm4.24-1.41L11.66 16.17 7.48 12l-1.41 1.41L11.66 19l12-12-1.42-1.41zM.41 13.41L6 19l1.41-1.41L1.83 12 .41 13.41z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Select All"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Search Bar + Filter -->
                        <Grid ColumnDefinitions="*,Auto"
                              IsVisible="{Binding !HasNoJobs}">
                            <!-- Unified Search Field -->
                            <Border Grid.Column="0"
                                    CornerRadius="12"
                                    Background="{DynamicResource InputBackground}"
                                    BorderBrush="{DynamicResource InputBorder}"
                                    BorderThickness="1.5"
                                    Padding="0">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Search Icon (inside) -->
                                    <Viewbox Grid.Column="0" Width="18" Height="18" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="{DynamicResource TextTertiary}" Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <!-- Search Input -->
                                    <TextBox Grid.Column="1"
                                             Text="{Binding SearchText, Mode=TwoWay}"
                                             Watermark="Search by name..."
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimary}"
                                             FontSize="14"
                                             Padding="10,10,6,10"
                                             VerticalContentAlignment="Center"
                                             Name="SearchBox"
                                             TextChanged="SearchBox_TextChanged"/>
                                    <!-- Clear Button -->
                                    <Button Grid.Column="2"
                                            Command="{Binding ClearSearchCommand}"
                                            Background="{DynamicResource ClickableCardBorder}"
                                            BorderThickness="0"
                                            CornerRadius="8"
                                            Padding="0"
                                            Cursor="Hand"
                                            IsVisible="{Binding SearchText.Length}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"
                                            Width="26" Height="26">
                                        <Viewbox Width="12" Height="12">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="{DynamicResource TextSecondary}" Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                </Grid>
                            </Border>
                            <!-- Filter Button -->
                            <Button Grid.Column="1"
                                    Command="{Binding ToggleFilterCommand}"
                                    Background="{DynamicResource InputBackground}"
                                    BorderBrush="{DynamicResource InputBorder}"
                                    BorderThickness="1.5"
                                    CornerRadius="12"
                                    Padding="10,8"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"
                                    Width="42" Height="42">
                                <Panel>
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="{DynamicResource TextSecondary}" Data="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <!-- Active filter dot -->
                                    <Ellipse Width="8" Height="8"
                                             Fill="#2196F3"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Top"
                                             Margin="0,-2,-2,0"
                                             IsVisible="{Binding HasActiveFilters}"/>
                                </Panel>
                            </Button>
                        </Grid>

                        <!-- Filter Panel -->
                        <Border CornerRadius="12"
                                Background="{DynamicResource InputBackground}"
                                BorderBrush="{DynamicResource InputBorder}"
                                BorderThickness="1.5"
                                Padding="20,16"
                                IsVisible="{Binding IsFilterOpen}"
                                Margin="0,-12,0,0">
                            <StackPanel Spacing="16">
                                <!-- Filter Header -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="Filters"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <Button Grid.Column="1"
                                            Command="{Binding ClearFiltersCommand}"
                                            Content="Clear all"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{DynamicResource AccentBlue}"
                                            FontSize="13"
                                            Padding="0"
                                            Cursor="Hand"
                                            IsVisible="{Binding HasActiveFilters}"/>
                                </Grid>

                                <!-- Backup Type Filter -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Backup Type"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <!-- All Types -->
                                        <Panel>
                                            <Button Content="All"
                                                    Command="{Binding ToggleAllTypesCommand}"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource ClickableCardBorder}"
                                                    Background="{DynamicResource InputBackground}"
                                                    IsVisible="{Binding !IsTypeAllSelected}"/>
                                            <Button Content="All"
                                                    Command="{Binding ToggleAllTypesCommand}"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="White"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource AccentBlue}"
                                                    Background="{DynamicResource AccentBlue}"
                                                    IsVisible="{Binding IsTypeAllSelected}"/>
                                        </Panel>
                                        <!-- Complete -->
                                        <Panel>
                                            <Button Content="Complete"
                                                    Command="{Binding ToggleFilterTypeCommand}"
                                                    CommandParameter="COMPLETE"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource ClickableCardBorder}"
                                                    Background="{DynamicResource InputBackground}"
                                                    IsVisible="{Binding !IsTypeCompleteSelected}"/>
                                            <Button Content="Complete"
                                                    Command="{Binding ToggleFilterTypeCommand}"
                                                    CommandParameter="COMPLETE"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="White"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource AccentBlue}"
                                                    Background="{DynamicResource AccentBlue}"
                                                    IsVisible="{Binding IsTypeCompleteSelected}"/>
                                        </Panel>
                                        <!-- Differential -->
                                        <Panel>
                                            <Button Content="Differential"
                                                    Command="{Binding ToggleFilterTypeCommand}"
                                                    CommandParameter="DIFFERENTIAL"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource ClickableCardBorder}"
                                                    Background="{DynamicResource InputBackground}"
                                                    IsVisible="{Binding !IsTypeDifferentialSelected}"/>
                                            <Button Content="Differential"
                                                    Command="{Binding ToggleFilterTypeCommand}"
                                                    CommandParameter="DIFFERENTIAL"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="White"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource AccentBlue}"
                                                    Background="{DynamicResource AccentBlue}"
                                                    IsVisible="{Binding IsTypeDifferentialSelected}"/>
                                        </Panel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Backup State Filter -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Status"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <WrapPanel Orientation="Horizontal">
                                        <WrapPanel.Styles>
                                            <Style Selector="Panel">
                                                <Setter Property="Margin" Value="0,0,8,8"/>
                                            </Style>
                                        </WrapPanel.Styles>
                                        <!-- All States -->
                                        <Panel>
                                            <Button Content="All"
                                                    Command="{Binding ToggleAllStatesCommand}"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource ClickableCardBorder}"
                                                    Background="{DynamicResource InputBackground}"
                                                    IsVisible="{Binding !IsStateAllSelected}"/>
                                            <Button Content="All"
                                                    Command="{Binding ToggleAllStatesCommand}"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="White"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource AccentBlue}"
                                                    Background="{DynamicResource AccentBlue}"
                                                    IsVisible="{Binding IsStateAllSelected}"/>
                                        </Panel>
                                        <!-- Pending -->
                                        <Panel>
                                            <Button Content="Pending"
                                                    Command="{Binding ToggleFilterStateCommand}"
                                                    CommandParameter="PENDING"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource ClickableCardBorder}"
                                                    Background="{DynamicResource InputBackground}"
                                                    IsVisible="{Binding !IsStatePendingSelected}"/>
                                            <Button Content="Pending"
                                                    Command="{Binding ToggleFilterStateCommand}"
                                                    CommandParameter="PENDING"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="White"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource AccentBlue}"
                                                    Background="{DynamicResource AccentBlue}"
                                                    IsVisible="{Binding IsStatePendingSelected}"/>
                                        </Panel>
                                        <!-- Active -->
                                        <Panel>
                                            <Button Content="Active"
                                                    Command="{Binding ToggleFilterStateCommand}"
                                                    CommandParameter="ACTIVE"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource ClickableCardBorder}"
                                                    Background="{DynamicResource InputBackground}"
                                                    IsVisible="{Binding !IsStateActiveSelected}"/>
                                            <Button Content="Active"
                                                    Command="{Binding ToggleFilterStateCommand}"
                                                    CommandParameter="ACTIVE"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="White"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource AccentBlue}"
                                                    Background="{DynamicResource AccentBlue}"
                                                    IsVisible="{Binding IsStateActiveSelected}"/>
                                        </Panel>
                                        <!-- Completed -->
                                        <Panel>
                                            <Button Content="Completed"
                                                    Command="{Binding ToggleFilterStateCommand}"
                                                    CommandParameter="COMPLETED"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource ClickableCardBorder}"
                                                    Background="{DynamicResource InputBackground}"
                                                    IsVisible="{Binding !IsStateCompletedSelected}"/>
                                            <Button Content="Completed"
                                                    Command="{Binding ToggleFilterStateCommand}"
                                                    CommandParameter="COMPLETED"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="White"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource AccentBlue}"
                                                    Background="{DynamicResource AccentBlue}"
                                                    IsVisible="{Binding IsStateCompletedSelected}"/>
                                        </Panel>
                                        <!-- Paused -->
                                        <Panel>
                                            <Button Content="Paused"
                                                    Command="{Binding ToggleFilterStateCommand}"
                                                    CommandParameter="PAUSED"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource ClickableCardBorder}"
                                                    Background="{DynamicResource InputBackground}"
                                                    IsVisible="{Binding !IsStatePausedSelected}"/>
                                            <Button Content="Paused"
                                                    Command="{Binding ToggleFilterStateCommand}"
                                                    CommandParameter="PAUSED"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="White"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource AccentBlue}"
                                                    Background="{DynamicResource AccentBlue}"
                                                    IsVisible="{Binding IsStatePausedSelected}"/>
                                        </Panel>
                                        <!-- Error -->
                                        <Panel>
                                            <Button Content="Error"
                                                    Command="{Binding ToggleFilterStateCommand}"
                                                    CommandParameter="ERROR"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource ClickableCardBorder}"
                                                    Background="{DynamicResource InputBackground}"
                                                    IsVisible="{Binding !IsStateErrorSelected}"/>
                                            <Button Content="Error"
                                                    Command="{Binding ToggleFilterStateCommand}"
                                                    CommandParameter="ERROR"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="White"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource AccentBlue}"
                                                    Background="{DynamicResource AccentBlue}"
                                                    IsVisible="{Binding IsStateErrorSelected}"/>
                                        </Panel>
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Empty State -->
                        <Border Classes="Card"
                                Padding="48"
                                Margin="0,8,0,16"
                                IsVisible="{Binding HasNoJobs}">
                            <StackPanel Spacing="16" HorizontalAlignment="Center">
                                <Viewbox Width="80" Height="80" Opacity="0.3">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{DynamicResource EmptyStateIcon}" Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="No backup tasks yet"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextTertiary}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Click the 'Add Backup Task' button below to create your first backup"
                                           FontSize="14"
                                           Foreground="{DynamicResource EmptyStateText}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- No Search Results -->
                        <Border Classes="Card"
                                Padding="32"
                                Margin="0,0,0,16"
                                IsVisible="{Binding HasNoFilteredJobs}">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Viewbox Width="48" Height="48" Opacity="0.3">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{DynamicResource EmptyStateIcon}" Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="No matching tasks found"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextTertiary}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Backup Jobs List -->
                        <ItemsControl ItemsSource="{Binding FilteredBackupJobs}" Margin="0,4,0,0" Padding="0,4,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="ClickableCard"
                                            Padding="0"
                                            Margin="0,0,0,16"
                                            Cursor="Hand"
                                            Tapped="BackupCard_Tapped">

                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto">

                                            <!-- Selection Zone (full height, left side) -->
                                            <Border Grid.Column="0" Grid.RowSpan="4"
                                                    Background="Transparent"
                                                    Width="56"
                                                    Cursor="Hand"
                                                    Tapped="SelectionZone_Tapped">
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          IsHitTestVisible="False"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Name and Type -->
                                            <StackPanel Grid.Column="1" Grid.Row="0" Spacing="4" Margin="0,24,0,0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="{Binding BackupTypeDisplay}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                            </StackPanel>

                                            <!-- Status Badge -->
                                            <Border Grid.Column="2" Grid.Row="0"
                                                    Padding="12,6"
                                                    CornerRadius="16"
                                                    Background="{Binding StateColor}"
                                                    Margin="0,24,24,0"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding BackupStateDisplay}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"/>
                                            </Border>

                                            <!-- Source → Destination -->
                                            <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="1"
                                                        Orientation="Horizontal"
                                                        Spacing="6"
                                                        Margin="0,8,24,0">
                                                <Viewbox Width="14" Height="14" VerticalAlignment="Center" Opacity="0.5">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Fill="{DynamicResource TextSecondary}" Data="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock Text="{Binding SourcePathDisplay}" FontSize="12" Foreground="{DynamicResource TextTertiary}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                                                <Viewbox Width="12" Height="12" VerticalAlignment="Center" Opacity="0.4" Margin="2,0">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Fill="{DynamicResource TextSecondary}" Data="M12 4l-1.41 1.41L16.17 11H4v2h12.17l-5.58 5.59L12 20l8-8z"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <Viewbox Width="14" Height="14" VerticalAlignment="Center" Opacity="0.5">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Fill="{DynamicResource TextSecondary}" Data="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"/>
                                                    </Canvas>
                                                </Viewbox>
                                                <TextBlock Text="{Binding TargetPath}" FontSize="12" Foreground="{DynamicResource TextTertiary}"
                                                           TextTrimming="CharacterEllipsis" MaxWidth="280"/>
                                            </StackPanel>

                                            <!-- Last Execution -->
                                            <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="2"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        Margin="0,12,24,0">
                                                <TextBlock Text="Last Execution:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                                <TextBlock Text="{Binding LastExecutionDisplay}" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>

                                            <!-- Progress Bar -->
                                            <StackPanel Grid.Column="1" Grid.ColumnSpan="2" Grid.Row="3"
                                                        Spacing="8"
                                                        Margin="0,12,24,24">
                                                <Grid ColumnDefinitions="120,*,Auto">
                                                    <TextBlock Grid.Column="0" Text="Progress:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                    <ProgressBar Grid.Column="1"
                                                                 Value="{Binding Progress}"
                                                                 Minimum="0"
                                                                 Maximum="100"
                                                                 Height="8"
                                                                 CornerRadius="4"
                                                                 Foreground="#2196F3"
                                                                 VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding ProgressDisplay}"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               Margin="12,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Bottom Spacer for scrolling -->
                        <Border Height="150"/>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Floating Buttons (hidden when settings/help open) -->
            <Panel Grid.Column="1" IsVisible="{Binding IsHomeActive}">

            <!-- Floating Action Button -->
            <Border Width="64"
                    Height="64"
                    CornerRadius="32"
                    BoxShadow="0 4 16 0 #502196F3"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,40,40"
                    Cursor="Hand"
                    ToolTip.Tip="Add Backup Task"
                    IsVisible="{Binding !HasSelectedJobs}"
                    RenderTransformOrigin="0.5,0.5"
                    Tapped="FAB_Tapped">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                        <GradientStop Color="#2196F3" Offset="0"/>
                        <GradientStop Color="#42A5F5" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.Styles>
                    <Style Selector="Border">
                        <Setter Property="Transitions">
                            <Setter.Value>
                                <Transitions>
                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2" Easing="CubicEaseOut"/>
                                    <BoxShadowsTransition Property="BoxShadow" Duration="0:0:0.2"/>
                                </Transitions>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style Selector="Border:pointerover">
                        <Setter Property="Background" Value="#1E88E5"/>
                        <Setter Property="BoxShadow" Value="0 8 24 0 #602196F3"/>
                        <Setter Property="RenderTransform" Value="translateY(-3px)"/>
                    </Style>
                </Border.Styles>
                <Viewbox Width="28" Height="28" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Fill="White" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                    </Canvas>
                </Viewbox>
            </Border>

            <!-- Floating Selection Action Bar -->
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,32"
                    CornerRadius="20"
                    Background="{DynamicResource CardBackground}"
                    BoxShadow="0 8 28 0 #50000000"
                    Padding="14,10"
                    IsVisible="{Binding HasSelectedJobs}">
                <StackPanel Orientation="Horizontal" Spacing="12">

                    <!-- Selected count -->
                    <Border Background="{DynamicResource AccentBlue}" CornerRadius="14" Padding="14,6" Margin="4,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedJobsCount, StringFormat='{}{0} selected'}"
                                   Foreground="White"
                                   VerticalAlignment="Center"
                                   FontWeight="SemiBold"
                                   FontSize="14"/>
                    </Border>

                    <!-- Deselect All -->
                    <Button Command="{Binding DeselectAllCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="10,8"
                            Cursor="Hand"
                            ToolTip.Tip="Deselect All">
                        <Viewbox Width="22" Height="22">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{DynamicResource TextSecondary}" Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" Height="34" Background="{DynamicResource ClickableCardBorder}" Margin="2,0"/>

                    <!-- Execute Selected -->
                    <Button Command="{Binding ShowExecuteOrderCommand}"
                            Background="#2196F3"
                            Width="48" Height="48"
                            CornerRadius="12"
                            Padding="0"
                            Cursor="Hand"
                            ToolTip.Tip="Execute Selected">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="White" Data="M8 5v14l11-7z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- Delete Selected -->
                    <Button Command="{Binding ShowDeleteConfirmCommand}"
                            Background="#F44336"
                            Width="48" Height="48"
                            CornerRadius="12"
                            Padding="0"
                            Cursor="Hand"
                            ToolTip.Tip="Delete Selected">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <Path Fill="White" Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                </StackPanel>
            </Border>

            </Panel> <!-- End floating buttons panel -->

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- Settings Panel -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <DockPanel Grid.Column="1"
                       IsVisible="{Binding IsSettingsOpen}">

            <!-- ───── Sticky Save Bar (docked bottom) ───── -->
            <Border DockPanel.Dock="Bottom"
                    Background="{DynamicResource CardBackground}"
                    BorderBrush="{DynamicResource ClickableCardBorder}"
                    BorderThickness="0,1,0,0"
                    Padding="40,14"
                    DataContext="{Binding SettingsVM}">
                <Grid MaxWidth="720" ColumnDefinitions="Auto,*,Auto,Auto">
                    <!-- Save message -->
                    <TextBlock Grid.Column="0"
                               Text="{Binding SaveMessage}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Foreground="#4CAF50"/>

                    <!-- Unsaved indicator -->
                    <TextBlock Grid.Column="1"
                               Text="{Binding TxtUnsaved, StringFormat='● {0}'}"
                               FontSize="12"
                               IsVisible="{Binding HasUnsavedChanges}"
                               Foreground="#FF9800"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center"
                               Margin="0,0,16,0"/>

                    <!-- Reset Button -->
                    <Button Grid.Column="2"
                            Command="{Binding ResetCommand}"
                            Content="{Binding TxtReset}"
                            Background="Transparent"
                            Foreground="{DynamicResource TextSecondary}"
                            BorderThickness="1"
                            BorderBrush="{DynamicResource ClickableCardBorder}"
                            CornerRadius="8"
                            Padding="20,8"
                            Margin="0,0,8,0"
                            Cursor="Hand"/>

                    <!-- Save Button -->
                    <Button Grid.Column="3"
                            Command="{Binding SaveCommand}"
                            Content="{Binding TxtSave}"
                            Background="#2196F3"
                            Foreground="White"
                            CornerRadius="8"
                            Padding="24,8"
                            FontWeight="SemiBold"
                            Cursor="Hand"/>
                </Grid>
            </Border>

            <!-- ScrollViewer fills remaining space -->
            <ScrollViewer Padding="40,32,40,40"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          DataContext="{Binding SettingsVM}">
                <StackPanel Spacing="28" MaxWidth="720">

                    <!-- Page Title with icon -->
                    <StackPanel Orientation="Horizontal" Spacing="14" Margin="0,0,0,4">
                        <Viewbox Width="32" Height="32" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{DynamicResource TextPrimary}" Data="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 00.12-.61l-1.92-3.32a.49.49 0 00-.59-.22l-2.39,0.96c-.5-.38-1.03-.7-1.62-.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 a.49.49 0 00-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-0.24 1.13-0.56 1.62-0.94l2.39,0.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58zM12 15.6A3.6 3.6 0 1115.6 12 3.611 3.611 0 0112 15.6z"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="{Binding TxtSettings}"
                                   FontSize="28"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- ───── General Section ───── -->
                    <Border Classes="Card" Padding="24" CornerRadius="14">
                        <StackPanel Spacing="20">
                            <!-- Section header with icon -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="36" Height="36" CornerRadius="10" Background="#222196F3">
                                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#2196F3" Data="M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TxtGeneral}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding TxtGeneralDesc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Theme Toggle -->
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Viewbox Grid.Column="0" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" Opacity="0.6">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{DynamicResource TextSecondary}" Data="M12 3a9 9 0 100 18 9 9 0 000-18zm0 16V5a7 7 0 010 14z"/>
                                    </Canvas>
                                </Viewbox>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TxtDarkMode}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding TxtDarkModeDesc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <ToggleSwitch Grid.Column="2"
                                              IsChecked="{Binding IsDarkTheme}"
                                              OnContent="{Binding TxtOn}"
                                              OffContent="{Binding TxtOff}"
                                              VerticalAlignment="Center"/>
                            </Grid>

                            <!-- Separator -->
                            <Border Height="1" Background="{DynamicResource ClickableCardBorder}" Margin="0,2"/>

                            <!-- Language -->
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Viewbox Grid.Column="0" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" Opacity="0.6">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{DynamicResource TextSecondary}" Data="M12.87 15.07l-2.54-2.51.03-.03A17.52 17.52 0 0014.07 6H17V4h-7V2H8v2H1v2h11.17C11.5 7.92 10.44 9.75 9 11.35 8.07 10.32 7.3 9.19 6.69 8h-2c.73 1.63 1.73 3.17 2.98 4.56l-5.09 5.02L4 19l5-5 3.11 3.11.76-2.04zM18.5 10h-2L12 22h2l1.12-3h4.75L21 22h2l-4.5-12zm-2.62 7l1.62-4.33L19.12 17h-3.24z"/>
                                    </Canvas>
                                </Viewbox>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TxtLanguage}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding TxtLanguageDesc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <ComboBox Grid.Column="2"
                                          SelectedIndex="{Binding LanguageIndex}"
                                          Width="180"
                                          Classes="ModernComboBox"
                                          VerticalAlignment="Center">
                                    <ComboBoxItem Content="English"/>
                                    <ComboBoxItem Content="Français"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- ───── Logging Section ───── -->
                    <Border Classes="Card" Padding="24" CornerRadius="14">
                        <StackPanel Spacing="20">
                            <!-- Section header with icon -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="36" Height="36" CornerRadius="10" Background="#22FF9800">
                                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#FF9800" Data="M14 2H6c-1.1 0-2 .9-2 2v16c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TxtLogging}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding TxtLoggingDesc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Log Format -->
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Viewbox Grid.Column="0" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" Opacity="0.6">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{DynamicResource TextSecondary}" Data="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0L19.2 12l-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"/>
                                    </Canvas>
                                </Viewbox>
                                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TxtLogFormat}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding TxtLogFormatDesc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                                <ComboBox Grid.Column="2"
                                          SelectedIndex="{Binding LogFormatIndex}"
                                          Width="180"
                                          Classes="ModernComboBox"
                                          VerticalAlignment="Center">
                                    <ComboBoxItem Content="JSON"/>
                                    <ComboBoxItem Content="XML"/>
                                </ComboBox>
                            </Grid>

                            <!-- Separator -->
                            <Border Height="1" Background="{DynamicResource ClickableCardBorder}" Margin="0,2"/>

                            <!-- Log File Path -->
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" Opacity="0.6">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="{DynamicResource TextSecondary}" Data="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding TxtLogPath}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding TxtLogPathDesc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding LogFilePath}"
                                             Watermark="/path/to/logs"
                                             CornerRadius="8 0 0 8"
                                             Padding="12,10"/>
                                    <Button Grid.Column="1"
                                            Name="BrowseLogPathButton"
                                            Click="BrowseLogPath_Click"
                                            Content="{Binding TxtBrowse}"
                                            Background="{DynamicResource SidebarBackground}"
                                            Foreground="{DynamicResource TextPrimary}"
                                            CornerRadius="0 8 8 0"
                                            Padding="16,10"
                                            VerticalAlignment="Stretch"
                                            Cursor="Hand"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ───── State Section ───── -->
                    <Border Classes="Card" Padding="24" CornerRadius="14">
                        <StackPanel Spacing="20">
                            <!-- Section header with icon -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="36" Height="36" CornerRadius="10" Background="#229C27B0">
                                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#9C27B0" Data="M13 3c-4.97 0-9 4.03-9 9H1l3.89 3.89.07.14L9 12H6c0-3.87 3.13-7 7-7s7 3.13 7 7-3.13 7-7 7c-1.93 0-3.68-.79-4.94-2.06l-1.42 1.42A8.954 8.954 0 0013 21c4.97 0 9-4.03 9-9s-4.03-9-9-9zm-1 5v5l4.28 2.54.72-1.21-3.5-2.08V8H12z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TxtState}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding TxtStateDesc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- State File Path -->
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" Opacity="0.6">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="{DynamicResource TextSecondary}" Data="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding TxtStatePath}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding TxtStatePathDesc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding StateFilePath}"
                                             Watermark="/path/to/state.json"
                                             CornerRadius="8 0 0 8"
                                             Padding="12,10"/>
                                    <Button Grid.Column="1"
                                            Name="BrowseStatePathButton"
                                            Click="BrowseStatePath_Click"
                                            Content="{Binding TxtBrowse}"
                                            Background="{DynamicResource SidebarBackground}"
                                            Foreground="{DynamicResource TextPrimary}"
                                            CornerRadius="0 8 8 0"
                                            Padding="16,10"
                                            VerticalAlignment="Stretch"
                                            Cursor="Hand"/>
                                </Grid>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ───── Backup Section ───── -->
                    <Border Classes="Card" Padding="24" CornerRadius="14">
                        <StackPanel Spacing="20">
                            <!-- Section header with icon -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="36" Height="36" CornerRadius="10" Background="#2226A69A">
                                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#26A69A" Data="M4 6h16v2H4V6zm0 5h16v2H4v-2zm0 5h10v2H4v-2z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TxtBackup}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding TxtBackupDesc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Blocked Applications -->
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" Opacity="0.6">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="{DynamicResource TextSecondary}" Data="M12 2a10 10 0 100 20 10 10 0 000-20zm5 11H7v-2h10v2z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding TxtBlockedApps}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding TxtBlockedAppsDesc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBox Text="{Binding BlockedApplicationsText}"
                                         Watermark="{Binding TxtBlockedAppsPlaceholder}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="90"
                                         CornerRadius="8"
                                         Padding="12,10"/>
                            </StackPanel>

                            <!-- Detected Applications -->
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" Opacity="0.6">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="{DynamicResource TextSecondary}" Data="M4 6h16v2H4V6zm0 5h16v2H4v-2zm0 5h16v2H4v-2z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding TxtDetectedApps}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding TxtDetectedAppsDesc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Grid ColumnDefinitions="Auto,Auto,Auto,*" Margin="0,2,0,0">
                                    <Button Grid.Column="0"
                                            Command="{Binding RefreshDetectedAppsCommand}"
                                            Content="{Binding TxtDetectAppsButton}"
                                            Background="{DynamicResource SidebarBackground}"
                                            Foreground="{DynamicResource TextPrimary}"
                                            CornerRadius="8"
                                            Padding="14,6"
                                            Margin="0,0,8,0"
                                            Cursor="Hand"/>
                                    <Button Grid.Column="1"
                                            Command="{Binding AddDetectedAppCommand}"
                                            Content="{Binding TxtAddBlockedAppButton}"
                                            Background="{DynamicResource CardBackground}"
                                            Foreground="{DynamicResource TextPrimary}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource ClickableCardBorder}"
                                            CornerRadius="8"
                                            Padding="14,6"
                                            Margin="0,0,8,0"
                                            Cursor="Hand"/>
                                    <Button Grid.Column="2"
                                            Click="BrowseExe_Click"
                                            Content="{Binding TxtBrowseExeButton}"
                                            Background="{DynamicResource CardBackground}"
                                            Foreground="{DynamicResource TextPrimary}"
                                            BorderThickness="1"
                                            BorderBrush="{DynamicResource ClickableCardBorder}"
                                            CornerRadius="8"
                                            Padding="14,6"
                                            Cursor="Hand"/>
                                </Grid>
                                <ListBox ItemsSource="{Binding DetectedApplications}"
                                         SelectedItem="{Binding SelectedDetectedApplication}"
                                         Height="160"
                                         BorderThickness="1"
                                         BorderBrush="{DynamicResource ClickableCardBorder}"
                                         CornerRadius="8"
                                         Padding="8"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ───── Encryption Section ───── -->
                    <Border Classes="Card" Padding="24" CornerRadius="14">
                        <StackPanel Spacing="20">
                            <!-- Section header with icon -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="36" Height="36" CornerRadius="10" Background="#228A8F52">
                                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#8A8F52" Data="M12 17a2 2 0 002-2v-2h-4v2a2 2 0 002 2zm6-6h-1V9a5 5 0 00-10 0v2H6a2 2 0 00-2 2v7a2 2 0 002 2h12a2 2 0 002-2v-7a2 2 0 00-2-2zm-3 0H9V9a3 3 0 016 0v2z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TxtEncryption}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding TxtEncryptionDesc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </StackPanel>

                            <!-- Cryptosoft Path -->
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" Opacity="0.6">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="{DynamicResource TextSecondary}" Data="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V10l-6-6h-6zm0 2v4h4V6h-4z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding TxtCryptosoftPath}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding TxtCryptosoftPathDesc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                    <TextBox Grid.Column="0"
                                             Text="{Binding CryptosoftPath}"
                                             Watermark="/path/to/cryptosoft"
                                             CornerRadius="8 0 0 8"
                                             Padding="12,10"/>
                                    <Button Grid.Column="1"
                                            Name="BrowseCryptosoftPathButton"
                                            Click="BrowseCryptosoftPath_Click"
                                            Content="{Binding TxtBrowse}"
                                            Background="{DynamicResource SidebarBackground}"
                                            Foreground="{DynamicResource TextPrimary}"
                                            CornerRadius="0 8 8 0"
                                            Padding="16,10"
                                            VerticalAlignment="Stretch"
                                            Cursor="Hand"/>
                                </Grid>
                            </StackPanel>

                            <!-- Encrypted Extensions -->
                            <StackPanel Spacing="6">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" Opacity="0.6">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="{DynamicResource TextSecondary}" Data="M12 17a2 2 0 002-2v-2h-4v2a2 2 0 002 2zm6-6h-1V9a5 5 0 00-10 0v2H6a2 2 0 00-2 2v7a2 2 0 002 2h12a2 2 0 002-2v-7a2 2 0 00-2-2zm-3 0H9V9a3 3 0 016 0v2z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding TxtEncryptedExtensions}" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding TxtEncryptedExtensionsDesc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    </StackPanel>
                                </StackPanel>
                                <TextBox Text="{Binding EncryptedExtensionsText}"
                                         Watermark="{Binding TxtEncryptedExtensionsPlaceholder}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         MinHeight="70"
                                         CornerRadius="8"
                                         Padding="12,10"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ───── About Section ───── -->
                    <Border Classes="Card" Padding="24" CornerRadius="14">
                        <StackPanel Spacing="16">
                            <!-- Section header with icon -->
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="36" Height="36" CornerRadius="10" Background="#22607D8B">
                                    <Viewbox Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#607D8B" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-6h2v6zm0-8h-2V7h2v2z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding TxtAbout}" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding TxtAboutDesc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </StackPanel>

                            <Grid ColumnDefinitions="*,Auto,*" Margin="0,8,0,0">
                                <!-- Left column: Product info -->
                                <StackPanel Grid.Column="0" Spacing="16" Margin="8,0,20,0">
                                    <!-- Software Name -->
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Viewbox Width="16" Height="16" VerticalAlignment="Center" Opacity="0.5">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="{DynamicResource TextSecondary}" Data="M19 12v7H5v-7H3v7c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2v-7h-2zm-6 .67l2.59-2.58L17 11.5l-5 5-5-5 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="Software" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock Text="EasySave" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Company -->
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Viewbox Width="16" Height="16" VerticalAlignment="Center" Opacity="0.5">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="{DynamicResource TextSecondary}" Data="M12 7V3H2v18h20V7H12zM6 19H4v-2h2v2zm0-4H4v-2h2v2zm0-4H4V9h2v2zm0-4H4V5h2v2zm4 12H8v-2h2v2zm0-4H8v-2h2v2zm0-4H8V9h2v2zm0-4H8V5h2v2zm10 12h-8v-2h2v-2h-2v-2h2v-2h-2V9h8v10zm-2-8h-2v2h2v-2zm0 4h-2v2h2v-2z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="Company" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock Text="ProSoft" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Version -->
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Viewbox Width="16" Height="16" VerticalAlignment="Center" Opacity="0.5">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="{DynamicResource TextSecondary}" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding TxtVersion}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock Text="{Binding AppVersion}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- License -->
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Viewbox Width="16" Height="16" VerticalAlignment="Center" Opacity="0.5">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="{DynamicResource TextSecondary}" Data="M12 1L3 5v6c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V5l-9-4zm-2 16l-4-4 1.41-1.41L10 14.17l6.59-6.59L18 9l-8 8z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="License" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock Text="Proprietary" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Vertical separator -->
                                <Border Grid.Column="1" Width="1" Background="{DynamicResource ClickableCardBorder}" VerticalAlignment="Stretch" HorizontalAlignment="Center" Margin="0,2"/>

                                <!-- Right column: Technical info -->
                                <StackPanel Grid.Column="2" Spacing="16" Margin="20,0,8,0">
                                    <!-- Runtime -->
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Viewbox Width="16" Height="16" VerticalAlignment="Center" Opacity="0.5">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="{DynamicResource TextSecondary}" Data="M9.4 16.6L4.8 12l4.6-4.6L8 6l-6 6 6 6 1.4-1.4zm5.2 0L19.2 12l-4.6-4.6L16 6l6 6-6 6-1.4-1.4z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding TxtRuntime}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock Text="{Binding DotNetVersion}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- UI Framework -->
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Viewbox Width="16" Height="16" VerticalAlignment="Center" Opacity="0.5">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="{DynamicResource TextSecondary}" Data="M21 3H3c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h18c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H3V5h18v14z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding TxtUiFramework}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock Text="{Binding AvaloniaVersion}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- OS -->
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Viewbox Width="16" Height="16" VerticalAlignment="Center" Opacity="0.5">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="{DynamicResource TextSecondary}" Data="M20 18c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2H4c-1.1 0-2 .9-2 2v10c0 1.1.9 2 2 2H0v2h24v-2h-4zM4 6h16v10H4V6z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="{Binding TxtOs}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock Text="{Binding OSInfo}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        </StackPanel>
                                    </StackPanel>

                                    <!-- Architecture -->
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Viewbox Width="16" Height="16" VerticalAlignment="Center" Opacity="0.5">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="{DynamicResource TextSecondary}" Data="M15 9H9v6h6V9zm-2 4h-2v-2h2v2zm8-2V9h-2V7c0-1.1-.9-2-2-2h-2V3h-2v2h-2V3H9v2H7c-1.1 0-2 .9-2 2v2H3v2h2v2H3v2h2v2c0 1.1.9 2 2 2h2v2h2v-2h2v2h2v-2h2c1.1 0 2-.9 2-2v-2h2v-2h-2v-2h2zm-4 6H7V7h10v10z"/>
                                            </Canvas>
                                        </Viewbox>
                                        <StackPanel Spacing="1">
                                            <TextBlock Text="Architecture" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                            <TextBlock Text="{Binding Architecture}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Bottom spacer so the About card is fully visible when scrolled down -->
                    <Border Height="80" Background="Transparent"/>

                </StackPanel>
            </ScrollViewer>

            </DockPanel> <!-- End Settings DockPanel -->

            <!-- ═══════════════════════════════════════════════════════════════ -->
            <!-- Help Panel -->
            <!-- ═══════════════════════════════════════════════════════════════ -->
            <ScrollViewer Grid.Column="1" Padding="32" IsVisible="{Binding IsHelpOpen}">
                <StackPanel Spacing="28" MaxWidth="820" HorizontalAlignment="Center">

                    <!-- Header -->
                    <StackPanel Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <Viewbox Width="36" Height="36" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#2196F3" Data="M11 18h2v-2h-2v2zm1-16C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 18c-4.41 0-8-3.59-8-8s3.59-8 8-8 8 3.59 8 8-3.59 8-8 8zm0-14c-2.21 0-4 1.79-4 4h2c0-1.1.9-2 2-2s2 .9 2 2c0 2-3 1.75-3 5h2c0-2.25 3-2.5 3-5 0-2.21-1.79-4-4-4z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding HelpTitle}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextPrimary}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock Text="{Binding HelpSubtitle}"
                                   FontSize="14"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- ──── Getting Started ──── -->
                    <Border Classes="Card" Padding="24">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="44" Height="44" CornerRadius="12" Background="#222196F3">
                                    <Viewbox Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#2196F3" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding HelpGettingStarted}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding HelpGettingStartedDesc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Height="1" Background="{DynamicResource ClickableCardBorder}" Margin="0,2"/>
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#222196F3">
                                            <TextBlock Text="1" FontSize="12" FontWeight="Bold" Foreground="#2196F3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding HelpStep1Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding HelpStep1Desc}" FontSize="13" Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap" Margin="32,0,0,0"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#222196F3">
                                            <TextBlock Text="2" FontSize="12" FontWeight="Bold" Foreground="#2196F3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding HelpStep2Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding HelpStep2Desc}" FontSize="13" Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap" Margin="32,0,0,0"/>
                                </StackPanel>
                                <StackPanel Spacing="4">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Border Width="24" Height="24" CornerRadius="12" Background="#222196F3">
                                            <TextBlock Text="3" FontSize="12" FontWeight="Bold" Foreground="#2196F3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <TextBlock Text="{Binding HelpStep3Title}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding HelpStep3Desc}" FontSize="13" Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap" Margin="32,0,0,0"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- ──── Features Grid (2 columns) ──── -->
                    <Grid ColumnDefinitions="*,16,*" RowDefinitions="Auto,16,Auto,16,Auto">

                        <!-- Backup Types -->
                        <Border Grid.Column="0" Grid.Row="0" Classes="Card" Padding="20">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="40" Height="40" CornerRadius="10" Background="#224CAF50">
                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="#4CAF50" Data="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm0 14H8V4h12v12z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Text="{Binding HelpBackupTypes}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center"/>
                                </StackPanel>
                                <StackPanel Spacing="8">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding HelpComplete, StringFormat='● {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="#4CAF50"/>
                                        <TextBlock Text="{Binding HelpCompleteDesc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding HelpDifferential, StringFormat='● {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="#FF9800"/>
                                        <TextBlock Text="{Binding HelpDifferentialDesc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Multiple Sources -->
                        <Border Grid.Column="2" Grid.Row="0" Classes="Card" Padding="20">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="40" Height="40" CornerRadius="10" Background="#225C6BC0">
                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="#5C6BC0" Data="M20 6h-8l-2-2H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Text="{Binding HelpMultiSources}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding HelpMultiSourcesDesc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding HelpMultiSourcesTip}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <!-- Execution Order -->
                        <Border Grid.Column="0" Grid.Row="2" Classes="Card" Padding="20">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="40" Height="40" CornerRadius="10" Background="#222196F3">
                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="#2196F3" Data="M3 15h18v-2H3v2zm0 4h18v-2H3v2zm0-8h18V9H3v2zm0-6v2h18V5H3z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Text="{Binding HelpExecOrder}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding HelpExecOrderDesc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding HelpExecOrderTip}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap" Opacity="0.7"/>
                            </StackPanel>
                        </Border>

                        <!-- Search &amp; Filters -->
                        <Border Grid.Column="2" Grid.Row="2" Classes="Card" Padding="20">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="40" Height="40" CornerRadius="10" Background="#22FF9800">
                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="#FF9800" Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Text="{Binding HelpSearchFilters}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding HelpSearchFiltersDesc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding HelpSearchFiltersTip}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap" Opacity="0.7"/>
                            </StackPanel>
                        </Border>

                        <!-- Settings -->
                        <Border Grid.Column="0" Grid.Row="4" Classes="Card" Padding="20">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="40" Height="40" CornerRadius="10" Background="#229C27B0">
                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="#9C27B0" Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Text="{Binding HelpSettings}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding HelpSettingsDesc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap"/>
                                <StackPanel Spacing="4" Margin="8,0,0,0">
                                    <TextBlock Text="{Binding HelpSettingsTheme, StringFormat='• {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding HelpSettingsLanguage, StringFormat='• {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding HelpSettingsLogFormat, StringFormat='• {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding HelpSettingsLogPath, StringFormat='• {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding HelpSettingsStatePath, StringFormat='• {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding HelpSettingsBlockedApps, StringFormat='• {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding HelpSettingsCryptosoftPath, StringFormat='• {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                    <TextBlock Text="{Binding HelpSettingsEncryptedExtensions, StringFormat='• {0}'}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Logs -->
                        <Border Grid.Column="2" Grid.Row="4" Classes="Card" Padding="20">
                            <StackPanel Spacing="12">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Border Width="40" Height="40" CornerRadius="10" Background="#22F44336">
                                        <Viewbox Width="20" Height="20" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="#F44336" Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <TextBlock Text="{Binding HelpLogs}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                                           VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="{Binding HelpLogsDesc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding HelpLogsTip}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap" Opacity="0.7"/>
                            </StackPanel>
                        </Border>

                    </Grid>

                    <!-- ──── Tips & Tricks ──── -->
                    <Border Classes="Card" Padding="24">
                        <StackPanel Spacing="14">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <Border Width="44" Height="44" CornerRadius="12" Background="#22FF9800">
                                    <Viewbox Width="22" Height="22" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="#FF9800" Data="M9 21c0 .55.45 1 1 1h4c.55 0 1-.45 1-1v-1H9v1zm3-19C8.14 2 5 5.14 5 9c0 2.38 1.19 4.47 3 5.74V17c0 .55.45 1 1 1h6c.55 0 1-.45 1-1v-2.26c1.81-1.27 3-3.36 3-5.74 0-3.86-3.14-7-7-7zm2.85 11.1l-.85.6V16h-4v-2.3l-.85-.6A4.997 4.997 0 017 9c0-2.76 2.24-5 5-5s5 2.24 5 5c0 1.63-.8 3.16-2.15 4.1z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <StackPanel Spacing="2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding HelpTips}" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                    <TextBlock Text="{Binding HelpTipsDesc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                                </StackPanel>
                            </StackPanel>
                            <Border Height="1" Background="{DynamicResource ClickableCardBorder}" Margin="0,2"/>
                            <Grid ColumnDefinitions="*,24,*">
                                <StackPanel Grid.Column="0" Spacing="10">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding HelpTip1Title, StringFormat='💡 {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding HelpTip1Desc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding HelpTip2Title, StringFormat='💡 {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding HelpTip2Desc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel Grid.Column="2" Spacing="10">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding HelpTip3Title, StringFormat='💡 {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding HelpTip3Desc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap"/>
                                    </StackPanel>
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="{Binding HelpTip4Title, StringFormat='💡 {0}'}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding HelpTip4Desc}" FontSize="12" Foreground="{DynamicResource TextSecondary}"
                                           TextWrapping="Wrap"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Bottom spacer -->
                    <Border Height="80"/>

                </StackPanel>
            </ScrollViewer>

        </Grid>
        <Panel IsVisible="{Binding IsAddEditModalOpen}" Background="#DD000000">
            <Border Classes="Card"
                    Width="650"
                    MaxHeight="650"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                    <StackPanel Spacing="24">

                        <!-- Modal Header -->
                        <TextBlock Text="{Binding ModalTitle}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <!-- Form Fields -->
                        <StackPanel Spacing="16">

                        <!-- Name Field -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Backup Name" FontWeight="SemiBold" Foreground="{DynamicResource TextLabel}"/>
                            <TextBox Classes="ModernTextBox"
                                     Text="{Binding ModalName}"
                                     Watermark="Enter backup name"/>
                        </StackPanel>

                        <!-- Source Paths Field -->
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Source Paths" FontWeight="SemiBold" Foreground="{DynamicResource TextLabel}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Command="{Binding AddSourcePathCommand}"
                                        Background="#4CAF50"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="8"
                                        CornerRadius="6"
                                        Cursor="Hand">
                                    <Viewbox Width="16" Height="16">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="White" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </Grid>

                            <!-- Scrollable Source Paths Container -->
                            <Border BorderBrush="{DynamicResource BorderSubtle}"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Padding="8,8,4,8"
                                    ClipToBounds="True">
                                <ScrollViewer MaxHeight="200"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="0,0,8,0">
                                    <ItemsControl ItemsSource="{Binding ModalSourcePaths}" HorizontalAlignment="Stretch">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel HorizontalAlignment="Stretch"/>
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.Styles>
                                            <Style Selector="ItemsControl > ContentPresenter">
                                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                            </Style>
                                        </ItemsControl.Styles>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <DockPanel Margin="0,0,0,8" LastChildFill="True" ClipToBounds="True">
                                                    <Button DockPanel.Dock="Right"
                                                            Command="{Binding $parent[Window].DataContext.RemoveSourcePathCommand}"
                                                            CommandParameter="{Binding}"
                                                            Background="#F44336"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Padding="0"
                                                            CornerRadius="10"
                                                            Width="42"
                                                            Height="40"
                                                            Margin="8,0,0,0"
                                                            Cursor="Hand"
                                                            HorizontalContentAlignment="Center"
                                                            VerticalContentAlignment="Center">
                                                        <Viewbox Width="18" Height="18">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Fill="White" Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Button>
                                                    <Button DockPanel.Dock="Right"
                                                            Classes="BrowseButton"
                                                            Width="42"
                                                            Margin="8,0,0,0"
                                                            Click="BrowseSourcePath_Click"
                                                            Tag="{Binding}"
                                                            ToolTip.Tip="Browse...">
                                                        <Viewbox Width="18" Height="18">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Fill="White" Data="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Button>
                                                    <Border ClipToBounds="True">
                                                        <TextBox Classes="ModernTextBox"
                                                                 Text="{Binding Path, Mode=TwoWay}"
                                                                 Watermark="e.g., C:\Documents"
                                                                 Name="SourcePathTextBox"/>
                                                    </Border>
                                                </DockPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <!-- Target Path Field -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Destination Path" FontWeight="SemiBold" Foreground="{DynamicResource TextLabel}"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0"
                                         Classes="ModernTextBox"
                                         Text="{Binding ModalTargetPath}"
                                         Watermark="e.g., D:\Backups\Documents"
                                         Name="TargetPathTextBox"/>
                                <Button Grid.Column="1"
                                        Classes="BrowseButton"
                                        Width="42"
                                        Margin="8,0,0,0"
                                        Click="BrowseTargetPath_Click"
                                        ToolTip.Tip="Browse...">
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="White" Data="M20 6h-8l-2-2H4c-1.1 0-1.99.9-1.99 2L2 18c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2zm0 12H4V8h16v10z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </Grid>
                        </StackPanel>

                        <!-- Backup Type Field -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Backup Type" FontWeight="SemiBold" Foreground="{DynamicResource TextLabel}"/>
                            <ComboBox Classes="ModernComboBox"
                                      SelectedIndex="{Binding ModalBackupTypeIndex}"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Complete"/>
                                <ComboBoxItem Content="Differential"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- Encrypt Files Field -->
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <Viewbox Grid.Column="0" Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Center" Opacity="0.6">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="{DynamicResource TextSecondary}" Data="M12 17a2 2 0 002-2v-2h-4v2a2 2 0 002 2zm6-6h-1V9a5 5 0 00-10 0v2H6a2 2 0 00-2 2v7a2 2 0 002 2h12a2 2 0 002-2v-7a2 2 0 00-2-2zm-3 0H9V9a3 3 0 016 0v2z"/>
                                </Canvas>
                            </Viewbox>
                            <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Encrypt files after backup" FontSize="14" FontWeight="Medium" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Uses Cryptosoft for matching extensions" FontSize="12" Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>
                            <ToggleSwitch Grid.Column="2"
                                          IsChecked="{Binding ModalEncryptFiles}"
                                          VerticalAlignment="Center"/>
                        </Grid>

                        <!-- Custom Encrypted Extensions (per-job) -->
                        <Border BorderThickness="1"
                                BorderBrush="{DynamicResource SettingsBorder}"
                                Background="{DynamicResource SettingsRowBackground}"
                                CornerRadius="8"
                                Padding="16,12"
                                IsVisible="{Binding ModalEncryptFiles}">
                            <StackPanel Spacing="8">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <Viewbox Grid.Column="0" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" Opacity="0.5">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="{DynamicResource TextSecondary}" Data="M12 2l-5.5 9h11z M12 17.5l5.5-9h-11z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding SettingsVM.TxtModalEncryptedExtensions}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}"/>
                                        <TextBlock Text="{Binding SettingsVM.TxtModalEncryptedExtensionsDesc}" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                                <TextBox Text="{Binding ModalEncryptedExtensions}"
                                         Watermark="{Binding SettingsVM.TxtModalEncryptedExtensionsPlaceholder}"
                                         Height="60"
                                         TextWrapping="Wrap"
                                         Classes="ModernTextBox"/>
                            </StackPanel>
                        </Border>

                        </StackPanel>

                        <!-- Validation Error -->
                        <TextBlock Text="{Binding ModalValidationError}"
                                   Foreground="#F44336"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   IsVisible="{Binding ModalValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Margin="0,-8,0,0"/>

                        <!-- Modal Actions -->
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                            <Button Classes="SecondaryButton"
                                    Content="Cancel"
                                    Command="{Binding CancelModalCommand}"/>
                            <Button Classes="PrimaryButton"
                                    Content="Execute"
                                    Command="{Binding ExecuteEditingJobCommand}"
                                    IsVisible="{Binding IsEditMode}"/>
                            <Button Classes="PrimaryButton"
                                    Content="Save"
                                    Command="{Binding SaveModalCommand}"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Panel>

        <!-- Progress Popup -->
        <Panel IsVisible="{Binding IsProgressPopupOpen}" Background="#EE000000">
            <Border Background="{DynamicResource PopupBackground}"
                    Width="600"
                    CornerRadius="12"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 24 4 #30000000">

                <StackPanel>
                    <!-- Header - In Progress -->
                    <Border CornerRadius="12,12,0,0"
                            Padding="0"
                            IsVisible="{Binding !ProgressViewModel.IsCompleted}">
                        <StackPanel>
                            <!-- Blue accent line -->
                            <Border Height="4" CornerRadius="12,12,0,0" Background="#2196F3"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="24,16,24,16">
                                <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#2196F3" Data="M12 4V1L8 5l4 4V6c3.31 0 6 2.69 6 6 0 1.01-.25 1.97-.7 2.8l1.46 1.46A7.93 7.93 0 0020 12c0-4.42-3.58-8-8-8zm0 14c-3.31 0-6-2.69-6-6 0-1.01.25-1.97.7-2.8L5.24 7.74A7.93 7.93 0 004 12c0 4.42 3.58 8 8 8v3l4-4-4-4v3z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Backup in Progress"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#2196F3"/>
                            </StackPanel>
                            <Border Height="1" Background="{DynamicResource ClickableCardBorder}" Margin="0,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Header - Completed -->
                    <Border CornerRadius="12,12,0,0"
                            Padding="0"
                            IsVisible="{Binding ProgressViewModel.IsCompleted}">
                        <StackPanel>
                            <!-- Green accent line -->
                            <Border Height="4" CornerRadius="12,12,0,0" Background="#4CAF50"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="24,16,24,16">
                                <Viewbox Width="24" Height="24" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#4CAF50" Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Backup Complete"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#4CAF50"/>
                            </StackPanel>
                            <Border Height="1" Background="{DynamicResource ClickableCardBorder}" Margin="0,0,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Content -->
                    <StackPanel Margin="24,20" Spacing="20">

                        <!-- Job Name -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Job Name"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding ProgressViewModel.JobName}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>

                        <!-- Current File -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Current File"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding ProgressViewModel.CurrentFile}"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"/>
                        </StackPanel>

                        <!-- Progress Bar -->
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="Progress"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ProgressViewModel.ProgressPercentage, StringFormat='{}{0}%'}"
                                           FontWeight="Bold"
                                           FontSize="18"
                                           Foreground="{DynamicResource AccentBlueLight}"/>
                            </Grid>

                            <ProgressBar Value="{Binding ProgressViewModel.ProgressPercentage}"
                                         Minimum="0"
                                         Maximum="100"
                                         Height="8"
                                         Foreground="{DynamicResource AccentBlueLight}"
                                         Background="{DynamicResource ProgressBarBg}"/>
                        </StackPanel>

                        <!-- Stats -->
                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,12,0">
                                <TextBlock Text="Files"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding ProgressViewModel.FilesDisplay}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4" Margin="12,0,0,0">
                                <TextBlock Text="Size"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding ProgressViewModel.SizeDisplay}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Speed & Time -->
                        <Grid ColumnDefinitions="*,*,*">
                            <StackPanel Grid.Column="0" Spacing="4">
                                <TextBlock Text="Elapsed"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding ProgressViewModel.ElapsedTimeDisplay}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4" Margin="12,0">
                                <TextBlock Text="Speed"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding ProgressViewModel.TransferSpeedDisplay}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Spacing="4" Margin="12,0,0,0">
                                <TextBlock Text="Remaining"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding ProgressViewModel.EstimatedTimeDisplay}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Close Button -->
                        <Button Classes="PrimaryButton"
                                Content="Close"
                                HorizontalAlignment="Stretch"
                                Height="40"
                                FontSize="15"
                                Command="{Binding CloseProgressCommand}"
                                IsVisible="{Binding ProgressViewModel.IsCompleted}"
                                Margin="0,4,0,0"/>

                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- Execute Order Popup -->
        <Panel IsVisible="{Binding IsExecuteOrderOpen}" Background="#DD000000">
            <Border Background="{DynamicResource PopupBackground}"
                    Width="500"
                    MaxHeight="550"
                    CornerRadius="16"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 24 4 #30000000">
                <StackPanel>
                    <!-- Header -->
                    <Border CornerRadius="16,16,0,0"
                            Padding="0">
                        <StackPanel>
                            <!-- Blue accent line -->
                            <Border Height="4" CornerRadius="16,16,0,0" Background="#2196F3"/>
                            <TextBlock Text="Execution Order"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="#2196F3"
                                       HorizontalAlignment="Center"
                                       Margin="24,16,24,16"/>
                            <Border Height="1" Background="{DynamicResource ClickableCardBorder}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="24,16" Spacing="12">
                        <TextBlock Text="Hold and drag to reorder (1 = first executed)"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondary}"/>

                        <!-- Reorderable List -->
                        <ScrollViewer Name="ExecuteOrderScroll" MaxHeight="320" VerticalScrollBarVisibility="Auto">
                            <ItemsControl Name="ExecuteOrderList" ItemsSource="{Binding ExecuteOrderJobs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10"
                                                Background="{DynamicResource CardBackground}"
                                                BorderBrush="{DynamicResource ClickableCardBorder}"
                                                BorderThickness="1.5"
                                                Padding="12,10"
                                                Margin="0,0,0,6"
                                                Cursor="Hand"
                                                Tag="OrderItem"
                                                PointerPressed="OrderItem_PointerPressed"
                                                PointerMoved="OrderItem_PointerMoved"
                                                PointerReleased="OrderItem_PointerReleased">
                                            <Border.Transitions>
                                                <Transitions>
                                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                                                </Transitions>
                                            </Border.Transitions>
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                <!-- Drag handle -->
                                                <Viewbox Grid.Column="0" Width="24" Height="24" Margin="0,0,12,0" VerticalAlignment="Center" Opacity="0.45" Cursor="Hand">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Fill="{DynamicResource TextSecondary}" Data="M11 18c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2zm-2-8c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0-6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm6 4c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>
                                                    </Canvas>
                                                </Viewbox>

                                                <!-- Order badge -->
                                                <Border Grid.Column="1"
                                                        Width="26" Height="26"
                                                        CornerRadius="13"
                                                        Background="#2196F3"
                                                        Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding OrderIndex}"
                                                               Foreground="White"
                                                               FontWeight="Bold"
                                                               FontSize="12"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Job info -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource TextPrimary}"/>
                                                    <TextBlock Text="{Binding BackupTypeDisplay}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondary}"/>
                                                </StackPanel>

                                                <!-- Up / Down arrows -->
                                                <StackPanel Grid.Column="3" Orientation="Vertical" Spacing="2" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).MoveJobUpCommand}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderThickness="0"
                                                            Padding="6,4" Cursor="Hand" MinHeight="0" MinWidth="0"
                                                            ToolTip.Tip="Move up">
                                                        <Viewbox Width="22" Height="22">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Fill="{DynamicResource TextSecondary}" Data="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Button>
                                                    <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).MoveJobDownCommand}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderThickness="0"
                                                            Padding="6,4" Cursor="Hand" MinHeight="0" MinWidth="0"
                                                            ToolTip.Tip="Move down">
                                                        <Viewbox Width="22" Height="22">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Fill="{DynamicResource TextSecondary}" Data="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6z"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Buttons -->
                        <Grid ColumnDefinitions="*,12,*" Margin="0,16,0,8">
                            <Button Grid.Column="0"
                                    Content="Cancel"
                                    HorizontalAlignment="Stretch"
                                    Height="40"
                                    FontSize="14"
                                    CornerRadius="10"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Background="{DynamicResource InputBackground}"
                                    BorderBrush="{DynamicResource ClickableCardBorder}"
                                    BorderThickness="1.5"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Cursor="Hand"
                                    Command="{Binding CancelExecuteOrderCommand}"/>
                            <Button Grid.Column="2"
                                    Content="▶  Execute"
                                    HorizontalAlignment="Stretch"
                                    Height="40"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    CornerRadius="10"
                                    Foreground="White"
                                    Background="#2196F3"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    Cursor="Hand"
                                    Command="{Binding ConfirmExecuteOrderCommand}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- Delete Confirmation Popup -->
        <Panel IsVisible="{Binding IsDeleteConfirmOpen}" Background="#DD000000">
            <Border Background="{DynamicResource PopupBackground}"
                    Width="420"
                    CornerRadius="16"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 24 4 #30000000">
                <StackPanel>
                    <!-- Header -->
                    <Border CornerRadius="16,16,0,0"
                            Padding="0">
                        <StackPanel>
                            <!-- Red accent line -->
                            <Border Height="4" CornerRadius="16,16,0,0" Background="#F44336"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="24,16,24,16">
                                <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#F44336" Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Confirm Deletion"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#F44336"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Height="1" Background="{DynamicResource ClickableCardBorder}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="24,20" Spacing="20">
                        <TextBlock Text="{Binding DeleteConfirmMessage}"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextPrimary}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>

                        <TextBlock Text="This action cannot be undone."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextTertiary}"
                                   HorizontalAlignment="Center"/>

                        <!-- Buttons -->
                        <Grid ColumnDefinitions="*,12,*" Margin="0,4,0,0">
                            <Button Grid.Column="0"
                                    Content="Cancel"
                                    HorizontalAlignment="Stretch"
                                    Height="40"
                                    FontSize="14"
                                    CornerRadius="10"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Background="{DynamicResource InputBackground}"
                                    BorderBrush="{DynamicResource ClickableCardBorder}"
                                    BorderThickness="1.5"
                                    HorizontalContentAlignment="Center"
                                    Cursor="Hand"
                                    Command="{Binding CancelDeleteCommand}"/>
                            <Button Grid.Column="2"
                                    Content="Delete"
                                    HorizontalAlignment="Stretch"
                                    Height="40"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    CornerRadius="10"
                                    Foreground="White"
                                    Background="#F44336"
                                    HorizontalContentAlignment="Center"
                                    Cursor="Hand"
                                    Command="{Binding ConfirmDeleteCommand}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- Blocked Application Popup -->
        <Panel IsVisible="{Binding IsBlockedPopupOpen}" Background="#DD000000">
            <Border Background="{DynamicResource PopupBackground}"
                    Width="460"
                    CornerRadius="16"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 24 4 #30000000">
                <StackPanel>
                    <!-- Header -->
                    <Border CornerRadius="16,16,0,0" Padding="0">
                        <StackPanel>
                            <!-- Orange accent line -->
                            <Border Height="4" CornerRadius="16,16,0,0" Background="#FF9800"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="24,16,24,16">
                                <Viewbox Width="24" Height="24" VerticalAlignment="Center">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#FF9800" Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="{Binding TxtBlockedPopupTitle}"
                                           FontSize="20"
                                           FontWeight="Bold"
                                           Foreground="#FF9800"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <Border Height="1" Background="{DynamicResource ClickableCardBorder}"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="24,20" Spacing="20">
                        <!-- Blocked icon + message -->
                        <StackPanel Spacing="12" HorizontalAlignment="Center">
                            <Viewbox Width="48" Height="48" HorizontalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="#FF9800" Data="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z" Opacity="0"/>
                                    <Path Fill="#FF9800" Data="M18.3 5.71a1 1 0 00-1.42 0L12 10.59 7.12 5.71a1 1 0 00-1.42 1.42L10.59 12l-4.88 4.88a1 1 0 001.42 1.42L12 13.41l4.88 4.88a1 1 0 001.42-1.42L13.41 12l4.88-4.88a1 1 0 000-1.41z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="{Binding BlockedPopupMessage}"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextPrimary}"
                                       TextWrapping="Wrap"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"/>
                        </StackPanel>

                        <!-- Close Button -->
                        <Button Content="{Binding TxtBlockedPopupClose}"
                                HorizontalAlignment="Stretch"
                                Height="40"
                                FontSize="14"
                                FontWeight="SemiBold"
                                CornerRadius="10"
                                Foreground="White"
                                Background="#FF9800"
                                HorizontalContentAlignment="Center"
                                VerticalContentAlignment="Center"
                                Cursor="Hand"
                                Command="{Binding CloseBlockedPopupCommand}"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- Toast Notification -->
        <Border IsVisible="{Binding IsToastVisible}"
                Background="#4CAF50"
                CornerRadius="12"
                Padding="16,12"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="0,0,32,24"
                BoxShadow="0 4 16 0 #40000000"
                MaxWidth="400">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Viewbox Grid.Column="0" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center">
                    <Canvas Width="24" Height="24">
                        <Path Fill="White" Data="M9 16.17L4.83 12l-1.42 1.41L9 19 21 7l-1.41-1.41z"/>
                    </Canvas>
                </Viewbox>
                <TextBlock Grid.Column="1" Text="{Binding ToastMessage}" Foreground="White" FontWeight="SemiBold"
                           FontSize="14" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Command="{Binding DismissToastCommand}" Background="Transparent"
                        BorderThickness="0" Padding="4" Margin="10,0,0,0" Cursor="Hand">
                    <Viewbox Width="14" Height="14">
                        <Canvas Width="24" Height="24">
                            <Path Fill="White" Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </Grid>
        </Border>

    </Grid>
</Window>
