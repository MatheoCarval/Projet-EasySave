<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="2400" d:DesignHeight="1400"
        x:Class="EasySave.View.GUI.MainWindow"
        Icon="/Assets/app-icon.png"
        Title="EasySave - Backup Manager"
        Width="1200"
        Height="700"
        MinWidth="900"
        MinHeight="600"
        Background="#F5F5F5">

    <Grid>
        <!-- Main Layout: Sidebar + Content -->
        <Grid ColumnDefinitions="100,*">

            <!-- Sidebar -->
            <Border Grid.Column="0" Classes="Sidebar">
                <Grid RowDefinitions="Auto,*,Auto,Auto">

                    <!-- Spacer -->
                    <Border Grid.Row="0"/>
                    <Border Grid.Row="1"/>

                    <!-- View Logs Button -->
                    <Button Grid.Row="2"
                            Classes="SidebarButton"
                            Command="{Binding ViewLogsCommand}"
                            ToolTip.Tip="View Logs"
                            Margin="12,8">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <!-- Document Icon -->
                                <Path Fill="#E0E0E0" Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- Settings Button -->
                    <Button Grid.Row="3"
                            Classes="SidebarButton"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip.Tip="Settings"
                            Margin="12,8,12,16">
                        <Viewbox Width="24" Height="24">
                            <Canvas Width="24" Height="24">
                                <!-- Settings Icon -->
                                <Path Fill="#E0E0E0" Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1">
                <ScrollViewer Padding="32">
                    <StackPanel Spacing="24" MaxWidth="1000">

                        <!-- Header with Action Buttons -->
                        <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                            <StackPanel Grid.Column="0" Spacing="8">
                                <TextBlock Text="Backup Tasks"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="#212121"/>
                                <TextBlock Text="Select tasks and execute them together"
                                           FontSize="14"
                                           Foreground="#757575"/>
                            </StackPanel>
                            <!-- Logo -->
                            <Image Grid.Column="1"
                                   Source="/Assets/app-icon-in.png"
                                   Width="110"
                                   Height="110"
                                   Stretch="Uniform"
                                   VerticalAlignment="Top"
                                   Margin="0,4,16,0"/>

                            <Button Grid.Column="2"
                                    Command="{Binding DeleteSelectedCommand}"
                                    VerticalAlignment="Center"
                                    Padding="16,10"
                                    Margin="0,0,12,0"
                                    Background="#F44336"
                                    Foreground="White"
                                    BorderThickness="0"
                                    CornerRadius="8"
                                    FontWeight="SemiBold"
                                    Cursor="Hand"
                                    IsVisible="{Binding HasSelectedJobs}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="White" Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Delete Selected" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Grid.Column="3"
                                    Classes="PrimaryButton"
                                    Command="{Binding ExecuteSelectedCommand}"
                                    VerticalAlignment="Center"
                                    Padding="20,12"
                                    IsVisible="{Binding HasSelectedJobs}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <Viewbox Width="20" Height="20">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="White" Data="M8 5v14l11-7z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <TextBlock Text="Execute Selected" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>

                        <!-- Empty State -->
                        <Border Classes="Card"
                                Padding="48"
                                Margin="0,0,0,16"
                                IsVisible="{Binding HasNoJobs}">
                            <StackPanel Spacing="16" HorizontalAlignment="Center">
                                <Viewbox Width="80" Height="80" Opacity="0.3">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="#9E9E9E" Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="No backup tasks yet"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="#9E9E9E"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Click the 'Add Backup Task' button below to create your first backup"
                                           FontSize="14"
                                           Foreground="#BDBDBD"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Backup Jobs List -->
                        <ItemsControl ItemsSource="{Binding BackupJobs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="Card"
                                            Padding="24"
                                            Margin="0,0,0,16"
                                            Cursor="Hand"
                                            Tapped="BackupCard_Tapped">
                                        <Border.Styles>
                                            <Style Selector="Border:pointerover">
                                                <Setter Property="BoxShadow" Value="0 4 12 0 #30000000"/>
                                            </Style>
                                        </Border.Styles>

                                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto">
                                            <!-- Checkbox -->
                                            <CheckBox Grid.Column="0" Grid.Row="0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      VerticalAlignment="Top"
                                                      Margin="0,0,16,0"/>

                                            <!-- Name and Type -->
                                            <StackPanel Grid.Column="1" Grid.Row="0" Spacing="4">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           Foreground="#212121"/>
                                                <TextBlock Text="{Binding BackupTypeDisplay}"
                                                           FontSize="13"
                                                           Foreground="#757575"/>
                                            </StackPanel>

                                            <!-- Status Badge -->
                                            <Border Grid.Column="2" Grid.Row="0"
                                                    Padding="12,6"
                                                    CornerRadius="16"
                                                    Background="{Binding StateColor}"
                                                    Margin="0,0,12,0"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding BackupStateDisplay}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"/>
                                            </Border>

                                            <!-- Edit Button -->
                                            <Button Grid.Column="3" Grid.Row="0"
                                                    Classes="SecondaryButton"
                                                    Content="Edit"
                                                    Padding="16,8"
                                                    Command="{Binding $parent[Window].DataContext.EditBackupCommand}"
                                                    VerticalAlignment="Top"/>

                                            <!-- Last Execution -->
                                            <StackPanel Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        Margin="0,12,0,0">
                                                <TextBlock Text="Last Execution:" FontWeight="SemiBold" Foreground="#616161"/>
                                                <TextBlock Text="{Binding LastExecutionDisplay}" Foreground="#212121"/>
                                            </StackPanel>

                                            <!-- Progress Bar -->
                                            <StackPanel Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="2"
                                                        Spacing="8"
                                                        Margin="0,12,0,0">
                                                <Grid ColumnDefinitions="120,*,Auto">
                                                    <TextBlock Grid.Column="0" Text="Progress:" FontWeight="SemiBold" Foreground="#616161" VerticalAlignment="Center"/>
                                                    <ProgressBar Grid.Column="1"
                                                                 Value="{Binding Progress}"
                                                                 Minimum="0"
                                                                 Maximum="100"
                                                                 Height="8"
                                                                 CornerRadius="4"
                                                                 Foreground="#2196F3"
                                                                 VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding ProgressDisplay}"
                                                               FontSize="13"
                                                               Foreground="#757575"
                                                               Margin="12,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Bottom Spacer for scrolling -->
                        <Border Height="150"/>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Floating Action Button -->
            <Border Grid.Column="1"
                    Width="64"
                    Height="64"
                    CornerRadius="32"
                    Background="#4CAF50"
                    BoxShadow="0 4 12 0 #40000000"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,40,40"
                    Cursor="Hand"
                    ToolTip.Tip="Add Backup Task">
                <Border.Styles>
                    <Style Selector="Border:pointerover">
                        <Setter Property="Background" Value="#45A049"/>
                        <Setter Property="BoxShadow" Value="0 6 16 0 #50000000"/>
                    </Style>
                </Border.Styles>
                <Button Command="{Binding AddBackupCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Cursor="Hand">
                    <Viewbox Width="28" Height="28">
                        <Canvas Width="24" Height="24">
                            <Path Fill="White" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </Border>

            <!-- Floating Execute Button (visible only when tasks are selected) -->
            <Border Grid.Column="1"
                    Height="64"
                    CornerRadius="32"
                    Background="#2196F3"
                    BoxShadow="0 4 12 0 #40000000"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,120,40"
                    Padding="24,0"
                    Cursor="Hand"
                    IsVisible="{Binding HasSelectedJobs}"
                    ToolTip.Tip="Execute Selected Tasks">
                <Border.Styles>
                    <Style Selector="Border:pointerover">
                        <Setter Property="Background" Value="#1976D2"/>
                        <Setter Property="BoxShadow" Value="0 6 16 0 #50000000"/>
                    </Style>
                </Border.Styles>
                <Button Command="{Binding ExecuteSelectedCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Viewbox Width="28" Height="28">
                            <Canvas Width="24" Height="24">
                                <Path Fill="White" Data="M8 5v14l11-7z"/>
                            </Canvas>
                        </Viewbox>
                        <TextBlock Text="Execute Selected"
                                   Foreground="White"
                                   FontWeight="SemiBold"
                                   FontSize="15"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Border>

        </Grid>

        <!-- Modal Overlay -->
        <Panel IsVisible="{Binding IsAddEditModalOpen}" Background="#CC000000">
            <Border Classes="Card"
                    Width="1200"
                    MaxHeight="650"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                    <StackPanel Spacing="24">

                        <!-- Modal Header -->
                        <TextBlock Text="{Binding ModalTitle}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="#212121"/>

                        <!-- Form Fields -->
                        <StackPanel Spacing="16">

                        <!-- Name Field -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Backup Name" FontWeight="SemiBold" Foreground="#616161"/>
                            <TextBox Classes="ModernTextBox"
                                     Text="{Binding ModalName}"
                                     Watermark="Enter backup name"/>
                        </StackPanel>

                        <!-- Source Paths Field -->
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Source Paths" FontWeight="SemiBold" Foreground="#616161" VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Command="{Binding AddSourcePathCommand}"
                                        Background="#4CAF50"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="8"
                                        CornerRadius="6"
                                        Cursor="Hand">
                                    <Viewbox Width="16" Height="16">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="White" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </Grid>

                            <!-- Scrollable Source Paths Container -->
                            <Border BorderBrush="#E0E0E0"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Padding="8,8,4,8">
                                <ScrollViewer MaxHeight="200"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="0,0,8,0">
                                    <ItemsControl ItemsSource="{Binding ModalSourcePaths}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                                                    <TextBox Grid.Column="0"
                                                             Classes="ModernTextBox"
                                                             Text="{Binding Path, Mode=TwoWay}"
                                                             Watermark="e.g., C:\Documents"/>
                                                    <Button Grid.Column="1"
                                                            Command="{Binding $parent[Window].DataContext.RemoveSourcePathCommand}"
                                                            CommandParameter="{Binding}"
                                                            Background="#F44336"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Padding="8"
                                                            CornerRadius="6"
                                                            Margin="8,0,0,0"
                                                            Cursor="Hand">
                                                        <Viewbox Width="16" Height="16">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Fill="White" Data="M19 13H5v-2h14v2z"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <!-- Target Path Field -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Destination Path" FontWeight="SemiBold" Foreground="#616161"/>
                            <TextBox Classes="ModernTextBox"
                                     Text="{Binding ModalTargetPath}"
                                     Watermark="e.g., D:\Backups\Documents"/>
                        </StackPanel>

                        <!-- Backup Type Field -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Backup Type" FontWeight="SemiBold" Foreground="#616161"/>
                            <ComboBox Classes="ModernComboBox"
                                      SelectedIndex="{Binding ModalBackupTypeIndex}"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Complete"/>
                                <ComboBoxItem Content="Differential"/>
                            </ComboBox>
                        </StackPanel>

                        </StackPanel>

                        <!-- Modal Actions -->
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                            <Button Classes="SecondaryButton"
                                    Content="Cancel"
                                    Command="{Binding CancelModalCommand}"/>
                            <Button Classes="PrimaryButton"
                                    Content="Save"
                                    Command="{Binding SaveModalCommand}"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Panel>

    </Grid>
</Window>
