<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:EasySave.ViewModels"
        mc:Ignorable="d" d:DesignWidth="2400" d:DesignHeight="1400"
        x:Class="EasySave.View.GUI.MainWindow"
        Icon="/Assets/app-icon.png"
        Title="EasySave - Backup Manager"
        Width="1200"
        Height="700"
        MinWidth="900"
        MinHeight="600"
        Background="{DynamicResource AppBackground}">

    <!-- Remove TextBox inner border/chrome for search -->
    <Window.Styles>
        <Style Selector="TextBox#SearchBox">
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="TextBox#SearchBox:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox#SearchBox:pointerover /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="TextBox#SearchBox /template/ Border#PART_BorderElement">
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
        </Style>
    </Window.Styles>

    <Grid>
        <!-- Main Layout: Sidebar + Content -->
        <Grid ColumnDefinitions="100,*">

            <!-- Sidebar -->
            <Border Grid.Column="0" Classes="Sidebar">
                <Grid RowDefinitions="Auto,*,Auto,Auto">

                    <!-- Home Button -->
                    <Button Grid.Row="0"
                            Classes="SidebarButton"
                            ToolTip.Tip="Home"
                            Margin="12,16,12,8">
                        <Viewbox Width="32" Height="32">
                            <Canvas Width="24" Height="24">
                                <!-- Home Icon -->
                                <Path Fill="{DynamicResource SidebarIcon}" Data="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- Spacer -->
                    <Border Grid.Row="1"/>

                    <!-- View Logs Button -->
                    <Button Grid.Row="2"
                            Classes="SidebarButton"
                            Command="{Binding ViewLogsCommand}"
                            ToolTip.Tip="View Logs"
                            Margin="12,8">
                        <Viewbox Width="32" Height="32">
                            <Canvas Width="24" Height="24">
                                <!-- Document Icon -->
                                <Path Fill="{DynamicResource SidebarIcon}" Data="M14 2H6c-1.1 0-1.99.9-1.99 2L4 20c0 1.1.89 2 1.99 2H18c1.1 0 2-.9 2-2V8l-6-6zm2 16H8v-2h8v2zm0-4H8v-2h8v2zm-3-5V3.5L18.5 9H13z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- Settings Button -->
                    <Button Grid.Row="3"
                            Classes="SidebarButton"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip.Tip="Settings"
                            Margin="12,8,12,16">
                        <Viewbox Width="32" Height="32">
                            <Canvas Width="24" Height="24">
                                <!-- Settings Icon -->
                                <Path Fill="{DynamicResource SidebarIcon}" Data="M19.14,12.94c0.04-0.3,0.06-0.61,0.06-0.94c0-0.32-0.02-0.64-0.07-0.94l2.03-1.58c0.18-0.14,0.23-0.41,0.12-0.61 l-1.92-3.32c-0.12-0.22-0.37-0.29-0.59-0.22l-2.39,0.96c-0.5-0.38-1.03-0.7-1.62-0.94L14.4,2.81c-0.04-0.24-0.24-0.41-0.48-0.41 h-3.84c-0.24,0-0.43,0.17-0.47,0.41L9.25,5.35C8.66,5.59,8.12,5.92,7.63,6.29L5.24,5.33c-0.22-0.08-0.47,0-0.59,0.22L2.74,8.87 C2.62,9.08,2.66,9.34,2.86,9.48l2.03,1.58C4.84,11.36,4.8,11.69,4.8,12s0.02,0.64,0.07,0.94l-2.03,1.58 c-0.18,0.14-0.23,0.41-0.12,0.61l1.92,3.32c0.12,0.22,0.37,0.29,0.59,0.22l2.39-0.96c0.5,0.38,1.03,0.7,1.62,0.94l0.36,2.54 c0.05,0.24,0.24,0.41,0.48,0.41h3.84c0.24,0,0.44-0.17,0.47-0.41l0.36-2.54c0.59-0.24,1.13-0.56,1.62-0.94l2.39,0.96 c0.22,0.08,0.47,0,0.59-0.22l1.92-3.32c0.12-0.22,0.07-0.47-0.12-0.61L19.14,12.94z M12,15.6c-1.98,0-3.6-1.62-3.6-3.6 s1.62-3.6,3.6-3.6s3.6,1.62,3.6,3.6S13.98,15.6,12,15.6z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                </Grid>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1">
                <ScrollViewer Padding="32">
                    <StackPanel Spacing="24" MaxWidth="1000">

                        <!-- Header with Action Buttons -->
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Spacing="8">
                                <TextBlock Text="Backup Tasks"
                                           FontSize="28"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="Manage your backup tasks"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextSecondary}"/>
                            </StackPanel>

                            <!-- Logo -->
                            <Image Grid.Column="1"
                                   Source="/Assets/app-icon-in.png"
                                   Width="110"
                                   Height="110"
                                   Stretch="Uniform"
                                   VerticalAlignment="Top"
                                   Margin="0,4,16,0"/>
                        </Grid>

                        <!-- Select All Button -->
                        <Button Command="{Binding SelectAllCommand}"
                                Background="Transparent"
                                BorderBrush="{DynamicResource ClickableCardBorder}"
                                BorderThickness="1.5"
                                CornerRadius="10"
                                Padding="14,8"
                                HorizontalAlignment="Left"
                                Cursor="Hand"
                                IsVisible="{Binding !HasNoJobs}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Viewbox Width="16" Height="16">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{DynamicResource TextSecondary}" Data="M18 7l-1.41-1.41-6.34 6.34 1.41 1.41L18 7zm4.24-1.41L11.66 16.17 7.48 12l-1.41 1.41L11.66 19l12-12-1.42-1.41zM.41 13.41L6 19l1.41-1.41L1.83 12 .41 13.41z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="Select All"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>

                        <!-- Search Bar + Filter -->
                        <Grid ColumnDefinitions="*,Auto"
                              IsVisible="{Binding !HasNoJobs}">
                            <!-- Unified Search Field -->
                            <Border Grid.Column="0"
                                    CornerRadius="12"
                                    Background="{DynamicResource InputBackground}"
                                    BorderBrush="{DynamicResource InputBorder}"
                                    BorderThickness="1.5"
                                    Padding="0">
                                <Grid ColumnDefinitions="Auto,*,Auto">
                                    <!-- Search Icon (inside) -->
                                    <Viewbox Grid.Column="0" Width="18" Height="18" Margin="14,0,0,0" VerticalAlignment="Center">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="{DynamicResource TextTertiary}" Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <!-- Search Input -->
                                    <TextBox Grid.Column="1"
                                             Text="{Binding SearchText, Mode=TwoWay}"
                                             Watermark="Search by name..."
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Foreground="{DynamicResource TextPrimary}"
                                             FontSize="14"
                                             Padding="10,10,6,10"
                                             VerticalContentAlignment="Center"
                                             Name="SearchBox"
                                             TextChanged="SearchBox_TextChanged"/>
                                    <!-- Clear Button -->
                                    <Button Grid.Column="2"
                                            Command="{Binding ClearSearchCommand}"
                                            Background="{DynamicResource ClickableCardBorder}"
                                            BorderThickness="0"
                                            CornerRadius="8"
                                            Padding="0"
                                            Cursor="Hand"
                                            IsVisible="{Binding SearchText.Length}"
                                            VerticalAlignment="Center"
                                            Margin="0,0,8,0"
                                            Width="26" Height="26">
                                        <Viewbox Width="12" Height="12">
                                            <Canvas Width="24" Height="24">
                                                <Path Fill="{DynamicResource TextSecondary}" Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                </Grid>
                            </Border>
                            <!-- Filter Button -->
                            <Button Grid.Column="1"
                                    Command="{Binding ToggleFilterCommand}"
                                    Background="{DynamicResource InputBackground}"
                                    BorderBrush="{DynamicResource InputBorder}"
                                    BorderThickness="1.5"
                                    CornerRadius="12"
                                    Padding="10,8"
                                    Cursor="Hand"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"
                                    Width="42" Height="42">
                                <Panel>
                                    <Viewbox Width="18" Height="18">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="{DynamicResource TextSecondary}" Data="M10 18h4v-2h-4v2zM3 6v2h18V6H3zm3 7h12v-2H6v2z"/>
                                        </Canvas>
                                    </Viewbox>
                                    <!-- Active filter dot -->
                                    <Ellipse Width="8" Height="8"
                                             Fill="#2196F3"
                                             HorizontalAlignment="Right"
                                             VerticalAlignment="Top"
                                             Margin="0,-2,-2,0"
                                             IsVisible="{Binding HasActiveFilters}"/>
                                </Panel>
                            </Button>
                        </Grid>

                        <!-- Filter Panel -->
                        <Border CornerRadius="12"
                                Background="{DynamicResource InputBackground}"
                                BorderBrush="{DynamicResource InputBorder}"
                                BorderThickness="1.5"
                                Padding="20,16"
                                IsVisible="{Binding IsFilterOpen}"
                                Margin="0,-12,0,0">
                            <StackPanel Spacing="16">
                                <!-- Filter Header -->
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Grid.Column="0"
                                               Text="Filters"
                                               FontSize="15"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextPrimary}"/>
                                    <Button Grid.Column="1"
                                            Command="{Binding ClearFiltersCommand}"
                                            Content="Clear all"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            Foreground="{DynamicResource AccentBlue}"
                                            FontSize="13"
                                            Padding="0"
                                            Cursor="Hand"
                                            IsVisible="{Binding HasActiveFilters}"/>
                                </Grid>

                                <!-- Backup Type Filter -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Backup Type"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <!-- All Types -->
                                        <Panel>
                                            <Button Content="All"
                                                    Command="{Binding ToggleAllTypesCommand}"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource ClickableCardBorder}"
                                                    Background="{DynamicResource InputBackground}"
                                                    IsVisible="{Binding !IsTypeAllSelected}"/>
                                            <Button Content="✓ All"
                                                    Command="{Binding ToggleAllTypesCommand}"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="White"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource AccentBlue}"
                                                    Background="{DynamicResource AccentBlue}"
                                                    IsVisible="{Binding IsTypeAllSelected}"/>
                                        </Panel>
                                        <!-- Complete -->
                                        <Panel>
                                            <Button Content="Complete"
                                                    Command="{Binding ToggleFilterTypeCommand}"
                                                    CommandParameter="COMPLETE"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource ClickableCardBorder}"
                                                    Background="{DynamicResource InputBackground}"
                                                    IsVisible="{Binding !IsTypeCompleteSelected}"/>
                                            <Button Content="✓ Complete"
                                                    Command="{Binding ToggleFilterTypeCommand}"
                                                    CommandParameter="COMPLETE"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="White"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource AccentBlue}"
                                                    Background="{DynamicResource AccentBlue}"
                                                    IsVisible="{Binding IsTypeCompleteSelected}"/>
                                        </Panel>
                                        <!-- Differential -->
                                        <Panel>
                                            <Button Content="Differential"
                                                    Command="{Binding ToggleFilterTypeCommand}"
                                                    CommandParameter="DIFFERENTIAL"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource ClickableCardBorder}"
                                                    Background="{DynamicResource InputBackground}"
                                                    IsVisible="{Binding !IsTypeDifferentialSelected}"/>
                                            <Button Content="✓ Differential"
                                                    Command="{Binding ToggleFilterTypeCommand}"
                                                    CommandParameter="DIFFERENTIAL"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="White"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource AccentBlue}"
                                                    Background="{DynamicResource AccentBlue}"
                                                    IsVisible="{Binding IsTypeDifferentialSelected}"/>
                                        </Panel>
                                    </StackPanel>
                                </StackPanel>

                                <!-- Backup State Filter -->
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Status"
                                               FontSize="12"
                                               FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextSecondary}"/>
                                    <WrapPanel Orientation="Horizontal">
                                        <WrapPanel.Styles>
                                            <Style Selector="Panel">
                                                <Setter Property="Margin" Value="0,0,8,8"/>
                                            </Style>
                                        </WrapPanel.Styles>
                                        <!-- All States -->
                                        <Panel>
                                            <Button Content="All"
                                                    Command="{Binding ToggleAllStatesCommand}"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource ClickableCardBorder}"
                                                    Background="{DynamicResource InputBackground}"
                                                    IsVisible="{Binding !IsStateAllSelected}"/>
                                            <Button Content="✓ All"
                                                    Command="{Binding ToggleAllStatesCommand}"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="White"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource AccentBlue}"
                                                    Background="{DynamicResource AccentBlue}"
                                                    IsVisible="{Binding IsStateAllSelected}"/>
                                        </Panel>
                                        <!-- Pending -->
                                        <Panel>
                                            <Button Content="Pending"
                                                    Command="{Binding ToggleFilterStateCommand}"
                                                    CommandParameter="PENDING"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource ClickableCardBorder}"
                                                    Background="{DynamicResource InputBackground}"
                                                    IsVisible="{Binding !IsStatePendingSelected}"/>
                                            <Button Content="✓ Pending"
                                                    Command="{Binding ToggleFilterStateCommand}"
                                                    CommandParameter="PENDING"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="White"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource AccentBlue}"
                                                    Background="{DynamicResource AccentBlue}"
                                                    IsVisible="{Binding IsStatePendingSelected}"/>
                                        </Panel>
                                        <!-- Active -->
                                        <Panel>
                                            <Button Content="Active"
                                                    Command="{Binding ToggleFilterStateCommand}"
                                                    CommandParameter="ACTIVE"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource ClickableCardBorder}"
                                                    Background="{DynamicResource InputBackground}"
                                                    IsVisible="{Binding !IsStateActiveSelected}"/>
                                            <Button Content="✓ Active"
                                                    Command="{Binding ToggleFilterStateCommand}"
                                                    CommandParameter="ACTIVE"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="White"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource AccentBlue}"
                                                    Background="{DynamicResource AccentBlue}"
                                                    IsVisible="{Binding IsStateActiveSelected}"/>
                                        </Panel>
                                        <!-- Completed -->
                                        <Panel>
                                            <Button Content="Completed"
                                                    Command="{Binding ToggleFilterStateCommand}"
                                                    CommandParameter="COMPLETED"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource ClickableCardBorder}"
                                                    Background="{DynamicResource InputBackground}"
                                                    IsVisible="{Binding !IsStateCompletedSelected}"/>
                                            <Button Content="✓ Completed"
                                                    Command="{Binding ToggleFilterStateCommand}"
                                                    CommandParameter="COMPLETED"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="White"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource AccentBlue}"
                                                    Background="{DynamicResource AccentBlue}"
                                                    IsVisible="{Binding IsStateCompletedSelected}"/>
                                        </Panel>
                                        <!-- Paused -->
                                        <Panel>
                                            <Button Content="Paused"
                                                    Command="{Binding ToggleFilterStateCommand}"
                                                    CommandParameter="PAUSED"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource ClickableCardBorder}"
                                                    Background="{DynamicResource InputBackground}"
                                                    IsVisible="{Binding !IsStatePausedSelected}"/>
                                            <Button Content="✓ Paused"
                                                    Command="{Binding ToggleFilterStateCommand}"
                                                    CommandParameter="PAUSED"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="White"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource AccentBlue}"
                                                    Background="{DynamicResource AccentBlue}"
                                                    IsVisible="{Binding IsStatePausedSelected}"/>
                                        </Panel>
                                        <!-- Error -->
                                        <Panel>
                                            <Button Content="Error"
                                                    Command="{Binding ToggleFilterStateCommand}"
                                                    CommandParameter="ERROR"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource ClickableCardBorder}"
                                                    Background="{DynamicResource InputBackground}"
                                                    IsVisible="{Binding !IsStateErrorSelected}"/>
                                            <Button Content="✓ Error"
                                                    Command="{Binding ToggleFilterStateCommand}"
                                                    CommandParameter="ERROR"
                                                    CornerRadius="8" Padding="12,6" FontSize="12" Cursor="Hand"
                                                    Foreground="White"
                                                    BorderThickness="1.5"
                                                    BorderBrush="{DynamicResource AccentBlue}"
                                                    Background="{DynamicResource AccentBlue}"
                                                    IsVisible="{Binding IsStateErrorSelected}"/>
                                        </Panel>
                                    </WrapPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <!-- Empty State -->
                        <Border Classes="Card"
                                Padding="48"
                                Margin="0,0,0,16"
                                IsVisible="{Binding HasNoJobs}">
                            <StackPanel Spacing="16" HorizontalAlignment="Center">
                                <Viewbox Width="80" Height="80" Opacity="0.3">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{DynamicResource EmptyStateIcon}" Data="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="No backup tasks yet"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextTertiary}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Click the 'Add Backup Task' button below to create your first backup"
                                           FontSize="14"
                                           Foreground="{DynamicResource EmptyStateText}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- No Search Results -->
                        <Border Classes="Card"
                                Padding="32"
                                Margin="0,0,0,16"
                                IsVisible="{Binding HasNoFilteredJobs}">
                            <StackPanel Spacing="8" HorizontalAlignment="Center">
                                <Viewbox Width="48" Height="48" Opacity="0.3">
                                    <Canvas Width="24" Height="24">
                                        <Path Fill="{DynamicResource EmptyStateIcon}" Data="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"/>
                                    </Canvas>
                                </Viewbox>
                                <TextBlock Text="No matching tasks found"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextTertiary}"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <!-- Backup Jobs List -->
                        <ItemsControl ItemsSource="{Binding FilteredBackupJobs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="ClickableCard"
                                            Padding="0"
                                            Margin="0,0,0,16"
                                            Cursor="Hand"
                                            Tapped="BackupCard_Tapped">

                                        <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto">

                                            <!-- Selection Zone (full height, left side) -->
                                            <Border Grid.Column="0" Grid.RowSpan="3"
                                                    Background="Transparent"
                                                    Width="56"
                                                    Cursor="Hand"
                                                    Tapped="SelectionZone_Tapped">
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          IsHitTestVisible="False"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>
                                            </Border>

                                            <!-- Name and Type -->
                                            <StackPanel Grid.Column="1" Grid.Row="0" Spacing="4" Margin="0,24,0,0">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TextPrimary}"/>
                                                <TextBlock Text="{Binding BackupTypeDisplay}"
                                                           FontSize="13"
                                                           Foreground="{DynamicResource TextSecondary}"/>
                                            </StackPanel>

                                            <!-- Status Badge -->
                                            <Border Grid.Column="2" Grid.Row="0"
                                                    Padding="12,6"
                                                    CornerRadius="16"
                                                    Background="{Binding StateColor}"
                                                    Margin="0,24,24,0"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding BackupStateDisplay}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           Foreground="White"/>
                                            </Border>

                                            <!-- Last Execution -->
                                            <StackPanel Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="1"
                                                        Orientation="Horizontal"
                                                        Spacing="8"
                                                        Margin="0,12,24,0">
                                                <TextBlock Text="Last Execution:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}"/>
                                                <TextBlock Text="{Binding LastExecutionDisplay}" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>

                                            <!-- Progress Bar -->
                                            <StackPanel Grid.Column="1" Grid.ColumnSpan="3" Grid.Row="2"
                                                        Spacing="8"
                                                        Margin="0,12,24,24">
                                                <Grid ColumnDefinitions="120,*,Auto">
                                                    <TextBlock Grid.Column="0" Text="Progress:" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" VerticalAlignment="Center"/>
                                                    <ProgressBar Grid.Column="1"
                                                                 Value="{Binding Progress}"
                                                                 Minimum="0"
                                                                 Maximum="100"
                                                                 Height="8"
                                                                 CornerRadius="4"
                                                                 Foreground="#2196F3"
                                                                 VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding ProgressDisplay}"
                                                               FontSize="13"
                                                               Foreground="{DynamicResource TextSecondary}"
                                                               Margin="12,0,0,0"
                                                               VerticalAlignment="Center"/>
                                                </Grid>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Bottom Spacer for scrolling -->
                        <Border Height="150"/>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Floating Action Button -->
            <Border Grid.Column="1"
                    Width="64"
                    Height="64"
                    CornerRadius="32"
                    Background="#4CAF50"
                    BoxShadow="0 4 12 0 #40000000"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Bottom"
                    Margin="0,0,40,40"
                    Cursor="Hand"
                    ToolTip.Tip="Add Backup Task"
                    IsVisible="{Binding !HasSelectedJobs}">
                <Border.Styles>
                    <Style Selector="Border:pointerover">
                        <Setter Property="Background" Value="#45A049"/>
                        <Setter Property="BoxShadow" Value="0 6 16 0 #50000000"/>
                    </Style>
                </Border.Styles>
                <Button Command="{Binding AddBackupCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Cursor="Hand">
                    <Viewbox Width="28" Height="28">
                        <Canvas Width="24" Height="24">
                            <Path Fill="White" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </Border>

            <!-- Floating Selection Action Bar -->
            <Border Grid.Column="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Bottom"
                    Margin="0,0,0,30"
                    CornerRadius="16"
                    Background="{DynamicResource CardBackground}"
                    BoxShadow="0 6 20 0 #50000000"
                    Padding="8,6"
                    IsVisible="{Binding HasSelectedJobs}">
                <StackPanel Orientation="Horizontal" Spacing="8">

                    <!-- Selected count -->
                    <TextBlock Text="{Binding SelectedJobsCount, StringFormat='{}{0} selected'}"
                               Foreground="{DynamicResource TextSecondary}"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Margin="10,0,6,0"/>

                    <!-- Deselect All -->
                    <Button Command="{Binding DeselectAllCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,6"
                            Cursor="Hand"
                            ToolTip.Tip="Deselect All">
                        <Viewbox Width="18" Height="18">
                            <Canvas Width="24" Height="24">
                                <Path Fill="{DynamicResource TextSecondary}" Data="M19 6.41L17.59 5 12 10.59 6.41 5 5 6.41 10.59 12 5 17.59 6.41 19 12 13.41 17.59 19 19 17.59 13.41 12z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- Separator -->
                    <Border Width="1" Height="28" Background="{DynamicResource ClickableCardBorder}" Margin="2,0"/>

                    <!-- Execute Selected -->
                    <Button Command="{Binding ShowExecuteOrderCommand}"
                            Background="#2196F3"
                            Width="40" Height="40"
                            CornerRadius="10"
                            Padding="0"
                            Cursor="Hand"
                            ToolTip.Tip="Execute Selected">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path Fill="White" Data="M8 5v14l11-7z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                    <!-- Delete Selected -->
                    <Button Command="{Binding ShowDeleteConfirmCommand}"
                            Background="#F44336"
                            Width="40" Height="40"
                            CornerRadius="10"
                            Padding="0"
                            Cursor="Hand"
                            ToolTip.Tip="Delete Selected">
                        <Viewbox Width="20" Height="20">
                            <Canvas Width="24" Height="24">
                                <Path Fill="White" Data="M6 19c0 1.1.9 2 2 2h8c1.1 0 2-.9 2-2V7H6v12zM19 4h-3.5l-1-1h-5l-1 1H5v2h14V4z"/>
                            </Canvas>
                        </Viewbox>
                    </Button>

                </StackPanel>
            </Border>

        </Grid>

        <!-- Modal Overlay -->
        <Panel IsVisible="{Binding IsAddEditModalOpen}" Background="#DD000000">
            <Border Classes="Card"
                    Width="1200"
                    MaxHeight="650"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,8,0">
                    <StackPanel Spacing="24">

                        <!-- Modal Header -->
                        <TextBlock Text="{Binding ModalTitle}"
                                   FontSize="24"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextPrimary}"/>

                        <!-- Form Fields -->
                        <StackPanel Spacing="16">

                        <!-- Name Field -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Backup Name" FontWeight="SemiBold" Foreground="{DynamicResource TextLabel}"/>
                            <TextBox Classes="ModernTextBox"
                                     Text="{Binding ModalName}"
                                     Watermark="Enter backup name"/>
                        </StackPanel>

                        <!-- Source Paths Field -->
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="Source Paths" FontWeight="SemiBold" Foreground="{DynamicResource TextLabel}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1"
                                        Command="{Binding AddSourcePathCommand}"
                                        Background="#4CAF50"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Padding="8"
                                        CornerRadius="6"
                                        Cursor="Hand">
                                    <Viewbox Width="16" Height="16">
                                        <Canvas Width="24" Height="24">
                                            <Path Fill="White" Data="M19 13h-6v6h-2v-6H5v-2h6V5h2v6h6v2z"/>
                                        </Canvas>
                                    </Viewbox>
                                </Button>
                            </Grid>

                            <!-- Scrollable Source Paths Container -->
                            <Border BorderBrush="{DynamicResource BorderSubtle}"
                                    BorderThickness="2"
                                    CornerRadius="8"
                                    Padding="8,8,4,8">
                                <ScrollViewer MaxHeight="200"
                                              VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Padding="0,0,8,0">
                                    <ItemsControl ItemsSource="{Binding ModalSourcePaths}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,8">
                                                    <TextBox Grid.Column="0"
                                                             Classes="ModernTextBox"
                                                             Text="{Binding Path, Mode=TwoWay}"
                                                             Watermark="e.g., C:\Documents"
                                                             Name="SourcePathTextBox"/>
                                                    <Button Grid.Column="1"
                                                            Classes="BrowseButton"
                                                            Content="..."
                                                            Width="40"
                                                            Margin="8,0,0,0"
                                                            Click="BrowseSourcePath_Click"
                                                            Tag="{Binding}"/>
                                                    <Button Grid.Column="2"
                                                            Command="{Binding $parent[Window].DataContext.RemoveSourcePathCommand}"
                                                            CommandParameter="{Binding}"
                                                            Background="#F44336"
                                                            Foreground="White"
                                                            BorderThickness="0"
                                                            Padding="8"
                                                            CornerRadius="6"
                                                            Margin="8,0,0,0"
                                                            Cursor="Hand">
                                                        <Viewbox Width="16" Height="16">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Fill="White" Data="M19 13H5v-2h14v2z"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>

                        <!-- Target Path Field -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Destination Path" FontWeight="SemiBold" Foreground="{DynamicResource TextLabel}"/>
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBox Grid.Column="0"
                                         Classes="ModernTextBox"
                                         Text="{Binding ModalTargetPath}"
                                         Watermark="e.g., D:\Backups\Documents"
                                         Name="TargetPathTextBox"/>
                                <Button Grid.Column="1"
                                        Classes="BrowseButton"
                                        Content="..."
                                        Width="40"
                                        Margin="8,0,0,0"
                                        Click="BrowseTargetPath_Click"/>
                            </Grid>
                        </StackPanel>

                        <!-- Backup Type Field -->
                        <StackPanel Spacing="8">
                            <TextBlock Text="Backup Type" FontWeight="SemiBold" Foreground="{DynamicResource TextLabel}"/>
                            <ComboBox Classes="ModernComboBox"
                                      SelectedIndex="{Binding ModalBackupTypeIndex}"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Content="Complete"/>
                                <ComboBoxItem Content="Differential"/>
                            </ComboBox>
                        </StackPanel>

                        </StackPanel>

                        <!-- Validation Error -->
                        <TextBlock Text="{Binding ModalValidationError}"
                                   Foreground="#F44336"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   IsVisible="{Binding ModalValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Margin="0,-8,0,0"/>

                        <!-- Modal Actions -->
                        <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
                            <Button Classes="SecondaryButton"
                                    Content="Cancel"
                                    Command="{Binding CancelModalCommand}"/>
                            <Button Classes="PrimaryButton"
                                    Content="Execute"
                                    Command="{Binding ExecuteEditingJobCommand}"
                                    IsVisible="{Binding IsEditMode}"/>
                            <Button Classes="PrimaryButton"
                                    Content="Save"
                                    Command="{Binding SaveModalCommand}"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Panel>

        <!-- Progress Popup -->
        <Panel IsVisible="{Binding IsProgressPopupOpen}" Background="#EE000000">
            <Border Background="{DynamicResource PopupBackground}"
                    Width="600"
                    CornerRadius="12"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 24 4 #30000000">

                <StackPanel>
                    <!-- Header - In Progress -->
                    <Border Background="#2196F3"
                            CornerRadius="12,12,0,0"
                            Padding="24,20"
                            IsVisible="{Binding !ProgressViewModel.IsCompleted}">
                        <TextBlock Text="Backup in Progress"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Header - Completed -->
                    <Border Background="#4CAF50"
                            CornerRadius="12,12,0,0"
                            Padding="24,20"
                            IsVisible="{Binding ProgressViewModel.IsCompleted}">
                        <TextBlock Text="Backup Complete"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <!-- Content -->
                    <StackPanel Margin="24,20" Spacing="20">

                        <!-- Job Name -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Job Name"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding ProgressViewModel.JobName}"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextPrimary}"/>
                        </StackPanel>

                        <!-- Current File -->
                        <StackPanel Spacing="6">
                            <TextBlock Text="Current File"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextSecondary}"/>
                            <TextBlock Text="{Binding ProgressViewModel.CurrentFile}"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="NoWrap"/>
                        </StackPanel>

                        <!-- Progress Bar -->
                        <StackPanel Spacing="12">
                            <Grid ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0"
                                           Text="Progress"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}"
                                           VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding ProgressViewModel.ProgressPercentage, StringFormat='{}{0}%'}"
                                           FontWeight="Bold"
                                           FontSize="18"
                                           Foreground="{DynamicResource AccentBlueLight}"/>
                            </Grid>

                            <ProgressBar Value="{Binding ProgressViewModel.ProgressPercentage}"
                                         Minimum="0"
                                         Maximum="100"
                                         Height="8"
                                         Foreground="{DynamicResource AccentBlueLight}"
                                         Background="{DynamicResource ProgressBarBg}"/>
                        </StackPanel>

                        <!-- Stats -->
                        <Grid ColumnDefinitions="*,*">
                            <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,12,0">
                                <TextBlock Text="Files"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding ProgressViewModel.FilesDisplay}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Spacing="4" Margin="12,0,0,0">
                                <TextBlock Text="Size"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextSecondary}"/>
                                <TextBlock Text="{Binding ProgressViewModel.SizeDisplay}"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Close Button -->
                        <Button Classes="PrimaryButton"
                                Content="Close"
                                HorizontalAlignment="Stretch"
                                Height="40"
                                FontSize="15"
                                Command="{Binding CloseProgressCommand}"
                                IsVisible="{Binding ProgressViewModel.IsCompleted}"
                                Margin="0,4,0,0"/>

                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- Execute Order Popup -->
        <Panel IsVisible="{Binding IsExecuteOrderOpen}" Background="#DD000000">
            <Border Background="{DynamicResource PopupBackground}"
                    Width="500"
                    MaxHeight="550"
                    CornerRadius="16"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 24 4 #30000000">
                <StackPanel>
                    <!-- Header -->
                    <Border Background="#2196F3"
                            CornerRadius="16,16,0,0"
                            Padding="24,18">
                        <TextBlock Text="Execution Order"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="24,16" Spacing="12">
                        <TextBlock Text="Hold and drag to reorder (1 = first executed)"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextSecondary}"/>

                        <!-- Reorderable List -->
                        <ScrollViewer Name="ExecuteOrderScroll" MaxHeight="320" VerticalScrollBarVisibility="Auto">
                            <ItemsControl Name="ExecuteOrderList" ItemsSource="{Binding ExecuteOrderJobs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="10"
                                                Background="{DynamicResource CardBackground}"
                                                BorderBrush="{DynamicResource ClickableCardBorder}"
                                                BorderThickness="1.5"
                                                Padding="12,10"
                                                Margin="0,0,0,6"
                                                Tag="OrderItem"
                                                PointerPressed="OrderItem_PointerPressed"
                                                PointerMoved="OrderItem_PointerMoved"
                                                PointerReleased="OrderItem_PointerReleased">
                                            <Border.Transitions>
                                                <Transitions>
                                                    <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.2"/>
                                                </Transitions>
                                            </Border.Transitions>
                                            <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                                                <!-- Drag handle -->
                                                <Viewbox Grid.Column="0" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" Opacity="0.35" Cursor="Hand">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Fill="{DynamicResource TextSecondary}" Data="M11 18c0 1.1-.9 2-2 2s-2-.9-2-2 .9-2 2-2 2 .9 2 2zm-2-8c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0-6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm6 4c1.1 0 2-.9 2-2s-.9-2-2-2-2 .9-2 2 .9 2 2 2zm0 2c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2zm0 6c-1.1 0-2 .9-2 2s.9 2 2 2 2-.9 2-2-.9-2-2-2z"/>
                                                    </Canvas>
                                                </Viewbox>

                                                <!-- Order badge -->
                                                <Border Grid.Column="1"
                                                        Width="26" Height="26"
                                                        CornerRadius="13"
                                                        Background="#2196F3"
                                                        Margin="0,0,10,0">
                                                    <TextBlock Text="{Binding OrderIndex}"
                                                               Foreground="White"
                                                               FontWeight="Bold"
                                                               FontSize="12"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center"/>
                                                </Border>

                                                <!-- Job info -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="2">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource TextPrimary}"/>
                                                    <TextBlock Text="{Binding BackupTypeDisplay}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource TextSecondary}"/>
                                                </StackPanel>

                                                <!-- Up / Down arrows -->
                                                <StackPanel Grid.Column="3" Orientation="Vertical" Spacing="0" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).MoveJobUpCommand}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderThickness="0"
                                                            Padding="4,2" Cursor="Hand" MinHeight="0" MinWidth="0"
                                                            ToolTip.Tip="Move up">
                                                        <Viewbox Width="16" Height="16">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Fill="{DynamicResource TextSecondary}" Data="M7.41 15.41L12 10.83l4.59 4.58L18 14l-6-6-6 6z"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Button>
                                                    <Button Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).MoveJobDownCommand}"
                                                            CommandParameter="{Binding}"
                                                            Background="Transparent" BorderThickness="0"
                                                            Padding="4,2" Cursor="Hand" MinHeight="0" MinWidth="0"
                                                            ToolTip.Tip="Move down">
                                                        <Viewbox Width="16" Height="16">
                                                            <Canvas Width="24" Height="24">
                                                                <Path Fill="{DynamicResource TextSecondary}" Data="M7.41 8.59L12 13.17l4.59-4.58L18 10l-6 6-6-6z"/>
                                                            </Canvas>
                                                        </Viewbox>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Buttons -->
                        <Grid ColumnDefinitions="*,12,*" Margin="0,8,0,0">
                            <Button Grid.Column="0"
                                    Content="Cancel"
                                    HorizontalAlignment="Stretch"
                                    Height="40"
                                    FontSize="14"
                                    CornerRadius="10"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Background="{DynamicResource InputBackground}"
                                    BorderBrush="{DynamicResource ClickableCardBorder}"
                                    BorderThickness="1.5"
                                    HorizontalContentAlignment="Center"
                                    Cursor="Hand"
                                    Command="{Binding CancelExecuteOrderCommand}"/>
                            <Button Grid.Column="2"
                                    Content="▶  Execute"
                                    HorizontalAlignment="Stretch"
                                    Height="40"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    CornerRadius="10"
                                    Foreground="White"
                                    Background="#2196F3"
                                    HorizontalContentAlignment="Center"
                                    Cursor="Hand"
                                    Command="{Binding ConfirmExecuteOrderCommand}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

        <!-- Delete Confirmation Popup -->
        <Panel IsVisible="{Binding IsDeleteConfirmOpen}" Background="#DD000000">
            <Border Background="{DynamicResource PopupBackground}"
                    Width="420"
                    CornerRadius="16"
                    Padding="0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 24 4 #30000000">
                <StackPanel>
                    <!-- Header -->
                    <Border Background="#F44336"
                            CornerRadius="16,16,0,0"
                            Padding="24,18">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                            <Viewbox Width="22" Height="22" VerticalAlignment="Center">
                                <Canvas Width="24" Height="24">
                                    <Path Fill="White" Data="M1 21h22L12 2 1 21zm12-3h-2v-2h2v2zm0-4h-2v-4h2v4z"/>
                                </Canvas>
                            </Viewbox>
                            <TextBlock Text="Confirm Deletion"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <StackPanel Margin="24,20" Spacing="20">
                        <TextBlock Text="{Binding DeleteConfirmMessage}"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextPrimary}"
                                   TextWrapping="Wrap"
                                   HorizontalAlignment="Center"
                                   TextAlignment="Center"/>

                        <TextBlock Text="This action cannot be undone."
                                   FontSize="12"
                                   Foreground="{DynamicResource TextTertiary}"
                                   HorizontalAlignment="Center"/>

                        <!-- Buttons -->
                        <Grid ColumnDefinitions="*,12,*" Margin="0,4,0,0">
                            <Button Grid.Column="0"
                                    Content="Cancel"
                                    HorizontalAlignment="Stretch"
                                    Height="40"
                                    FontSize="14"
                                    CornerRadius="10"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Background="{DynamicResource InputBackground}"
                                    BorderBrush="{DynamicResource ClickableCardBorder}"
                                    BorderThickness="1.5"
                                    HorizontalContentAlignment="Center"
                                    Cursor="Hand"
                                    Command="{Binding CancelDeleteCommand}"/>
                            <Button Grid.Column="2"
                                    Content="Delete"
                                    HorizontalAlignment="Stretch"
                                    Height="40"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    CornerRadius="10"
                                    Foreground="White"
                                    Background="#F44336"
                                    HorizontalContentAlignment="Center"
                                    Cursor="Hand"
                                    Command="{Binding ConfirmDeleteCommand}"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Panel>

    </Grid>
</Window>
